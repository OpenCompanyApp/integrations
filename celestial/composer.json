{
    "name": "opencompanyapp/integration-celestial",
    "description": "Celestial/astronomy integration for Laravel — moon phases, sunrise/sunset, planet positions, eclipses, night sky reports.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "astronomy", "celestial", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev",
        "opencompanyapp/astronomy-bundle": "^3.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-celestial": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Celestial\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Celestial\\CelestialServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
