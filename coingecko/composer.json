{
    "name": "opencompanyapp/integration-coingecko",
    "description": "CoinGecko cryptocurrency integration for Laravel — search coins, prices, market data, trending, historical charts.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "crypto", "coingecko", "bitcoin", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-coingecko": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\CoinGecko\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\CoinGecko\\CoinGeckoServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
