{
    "name": "opencompanyapp/integration-core",
    "description": "Core framework for OpenCompany integration packages \u2014 contracts, credential abstraction, and auto-discovery registry.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": [
        "integrations",
        "tools",
        "agents",
        "opencompany"
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\IntegrationCore\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.0.x-dev"
        },
        "laravel": {
            "providers": [
                "OpenCompany\\IntegrationCore\\IntegrationCoreServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
