{
    "name": "opencompanyapp/integration-abyssale",
    "description": "Abyssale creative automation integration for Laravel — designs, generation, files, exports, projects, and dynamic images.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "abyssale", "rendering", "image-generation", "creative-automation", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-abyssale": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Abyssale\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Abyssale\\AbyssaleServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
