{
    "name": "opencompanyapp/integration-accelo",
    "description": "Accelo integration for Laravel — manage tickets, tasks, and projects.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "accelo", "productivity", "psa", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-accelo": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Accelo\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Accelo\\AcceloServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
