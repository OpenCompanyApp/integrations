{
    "name": "opencompanyapp/integration-activecampaign",
    "description": "ActiveCampaign integration for Laravel — manage contacts, lists, deals, automations, and notes.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "activecampaign", "crm", "email-marketing", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\ActiveCampaign\\": "src/"
        }
