{
    "name": "opencompanyapp/integration-actively",
    "description": "Actively CRM integration for Laravel — manage campaigns, contacts, and organizations.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "actively", "sales", "crm", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-actively": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Actively\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Actively\\ActivelyServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
