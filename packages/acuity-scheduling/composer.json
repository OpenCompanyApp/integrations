{
    "name": "opencompanyapp/integration-acuity-scheduling",
    "description": "Acuity Scheduling integration for Laravel — manage appointments, clients, calendars, and availability.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "acuity-scheduling", "appointments", "scheduling", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-acuity-scheduling": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\AcuityScheduling\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\AcuityScheduling\\AcuitySchedulingServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
