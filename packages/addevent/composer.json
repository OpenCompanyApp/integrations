{
    "name": "opencompanyapp/integration-addevent",
    "description": "AddEvent Calendar and Events API v2 integration for Laravel - manage events and calendars.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "addevent", "calendar", "productivity", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-addevent": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\AddEvent\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\AddEvent\\AddEventServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
