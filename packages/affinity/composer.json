{
    "name": "opencompanyapp/integration-affinity",
    "description": "Affinity CRM integration for Laravel — manage contacts, organizations, and lists.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "affinity", "crm", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-affinity": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Affinity\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Affinity\\AffinityServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
