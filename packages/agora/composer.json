{
    "name": "opencompanyapp/integration-agora",
    "description": "Agora real-time communication integration for Laravel — manage projects, recordings, and user data.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "agora", "communication", "real-time", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-agora": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Agora\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Agora\\AgoraServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
