{
    "name": "opencompanyapp/integration-ahrefs",
    "description": "Ahrefs API v3 integration for Laravel agents with Site Explorer, subscription usage, and generic GET tools.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "ahrefs", "api-v3", "site-explorer", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-ahrefs": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Ahrefs\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Ahrefs\\AhrefsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
