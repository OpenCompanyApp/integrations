{
    "name": "opencompanyapp/integration-aircall",
    "description": "Aircall integration for Laravel — manage calls, contacts, users, and phone numbers.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "aircall", "voip", "phone", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-aircall": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Aircall\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Aircall\\AircallServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
