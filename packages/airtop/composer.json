{
    "name": "opencompanyapp/integration-airtop",
    "description": "Airtop integration for Laravel with generated tools from the official Airtop OpenAPI specification.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "airtop", "browser", "automation", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-airtop": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Airtop\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Airtop\\AirtopServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
