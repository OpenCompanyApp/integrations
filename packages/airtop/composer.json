{
    "name": "opencompanyapp/integration-airtop",
    "description": "Airtop browser automation integration for Laravel — create sessions, manage windows, navigate pages, and extract content.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "airtop", "browser", "automation", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-airtop": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Airtop\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Airtop\\AirtopServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
