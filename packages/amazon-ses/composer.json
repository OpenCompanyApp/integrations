{
    "name": "opencompanyapp/integration-amazon-ses",
    "description": "Amazon SES integration for Laravel agents with SigV4-signed SES v2 email, identity, template, suppression, and generic API tools.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "amazon-ses", "ses-v2", "aws-sigv4", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-amazon-ses": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\AmazonSes\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\AmazonSes\\AmazonSesServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
