{
    "name": "opencompanyapp/integration-amplitude",
    "description": "Amplitude Analytics integration for Laravel — events, funnels, cohorts, and user identity.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "amplitude", "analytics", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-amplitude": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Amplitude\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Amplitude\\AmplitudeServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
