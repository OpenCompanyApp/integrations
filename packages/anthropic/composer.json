{
    "name": "opencompanyapp/integration-anthropic",
    "description": "Anthropic Claude integration for Laravel - messages, token counting, batches, files, models, and organization administration.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "anthropic", "claude", "ai", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-anthropic": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Anthropic\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Anthropic\\AnthropicServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
