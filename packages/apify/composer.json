{
    "name": "opencompanyapp/integration-apify",
    "description": "Apify integration for Laravel with generated tools from the official Apify OpenAPI specification.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "apify", "scraping", "automation", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-apify": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Apify\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Apify\\ApifyServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
