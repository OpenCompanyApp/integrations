{
    "name": "opencompanyapp/integration-apitemplateio",
    "description": "APITemplate.io integration for Laravel — generate PDFs and images from templates, HTML, URLs, Markdown, and PDF merge workflows.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "apitemplateio", "rendering", "pdf", "images", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-apitemplateio": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\ApiTemplateIO\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\ApiTemplateIO\\ApiTemplateIOServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
