{
    "name": "opencompanyapp/integration-apollo",
    "description": "Apollo.io integration for Laravel agents with people, organization, contact, account, and usage API tools.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "apollo", "b2b-data", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-apollo": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Apollo\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Apollo\\ApolloServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
