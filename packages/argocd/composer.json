{
    "name": "opencompanyapp/integration-argocd",
    "description": "Argo CD integration for OpenCompany - GitOps application management, projects, and repositories.",
    "license": "MIT",
    "authors": [{"name": "OpenCompany", "homepage": "https://github.com/OpenCompanyApp"}],
    "keywords": ["tools", "argocd", "gitops", "kubernetes", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "autoload": {
        "psr-4": {"OpenCompany\\Integrations\\ArgoCd\\": "src/"}
    },
    "extra": {
        "laravel": {
            "providers": ["OpenCompany\\Integrations\\ArgoCd\\ArgoCdServiceProvider"]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
