{
    "name": "opencompanyapp/integration-ashby",
    "description": "Ashby ATS integration for Laravel - manage candidates, applications, jobs, interviews, offers, webhooks, and raw API calls.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "ashby", "ats", "hr", "recruiting", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-ashby": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Ashby\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Ashby\\AshbyServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
