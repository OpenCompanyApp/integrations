{
    "name": "opencompanyapp/integration-assemblyai",
    "description": "AssemblyAI integration for Laravel — transcripts, uploads, streaming tokens, and LLM Gateway chat.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "assemblyai", "ai", "speech", "transcription", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-assemblyai": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\AssemblyAI\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\AssemblyAI\\AssemblyAIServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
