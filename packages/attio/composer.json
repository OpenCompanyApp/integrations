{
    "name": "opencompanyapp/integration-attio",
    "description": "Attio CRM integration for Laravel - manage records, objects, attributes, lists, entries, notes, tasks, webhooks, and raw REST API calls.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "attio", "crm", "sales", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-attio": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Attio\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Attio\\AttioServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
