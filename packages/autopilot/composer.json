{
    "name": "opencompanyapp/integration-autopilot",
    "description": "Autopilot integration for Laravel covering the official contact, list, journey ejection, and REST hook APIs.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "autopilot", "marketing", "automation", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0"
    },
    "replace": {
        "opencompanyapp/ai-tool-autopilot": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Autopilot\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Autopilot\\AutopilotServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
