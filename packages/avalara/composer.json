{
    "name": "opencompanyapp/integration-avalara",
    "description": "Avalara integration for Laravel — automate tax calculation, transactions, and compliance.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "avalara", "tax", "sales", "compliance", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-avalara": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Avalara\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Avalara\\AvalaraServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
