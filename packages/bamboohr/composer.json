{
    "name": "opencompanyapp/integration-bamboohr",
    "description": "BambooHR integration for Laravel — manage employees, departments, and time-off requests.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "bamboohr", "hr", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-bamboohr": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\BambooHR\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\BambooHR\\BambooHRServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
