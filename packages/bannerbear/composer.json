{
    "name": "opencompanyapp/integration-bannerbear",
    "description": "Bannerbear integration for Laravel — generate images, videos, animated GIFs from templates.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "bannerbear", "images", "videos", "automation", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-bannerbear": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Bannerbear\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Bannerbear\\BannerbearServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
