{
    "name": "opencompanyapp/integration-basecamp",
    "description": "Basecamp 3 integration for Laravel — manage projects, to-dos, and messages.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "basecamp", "productivity", "project-management", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-basecamp": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Basecamp\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Basecamp\\BasecampServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
