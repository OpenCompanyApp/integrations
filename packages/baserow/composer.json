{
    "name": "opencompanyapp/integration-baserow",
    "description": "Baserow database integration for Laravel: manage tables, fields, rows, batch operations, and user info.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "baserow", "database", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-baserow": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Baserow\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Baserow\\BaserowServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
