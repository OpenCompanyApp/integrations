{
    "name": "opencompanyapp/integration-beamer",
    "description": "Beamer integration for Laravel agents with changelog, comments, categories, user profile, and generic API tools.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "beamer", "changelog", "product-updates", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-beamer": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Beamer\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Beamer\\BeamerServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
