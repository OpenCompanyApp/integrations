{
    "name": "opencompanyapp/integration-bigcommerce",
    "description": "BigCommerce integration for Laravel — manage products, orders, customers, and categories.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "bigcommerce", "ecommerce", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-bigcommerce": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\BigCommerce\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\BigCommerce\\BigCommerceServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
