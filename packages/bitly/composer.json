{
    "name": "opencompanyapp/integration-bitly",
    "description": "Bitly link management integration for the OpenCompany AI platform — shorten links, manage bitlinks, track clicks.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "*",
        "laravel/ai": "^0.1",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Bitly\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Bitly\\BitlyServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
