{
    "name": "opencompanyapp/integration-bitly",
    "description": "Bitly API v4 integration for Laravel agents with links, analytics, QR codes, webhooks, and generic REST tools.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev",
        "laravel/ai": "^0.1 || ^0.6",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Bitly\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Bitly\\BitlyServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
