{
    "name": "opencompanyapp/integration-bitrise",
    "description": "Bitrise integration for Laravel AI agents - apps, builds, webhooks, artifacts, secrets, signing files, storage, and raw API helper calls.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Bitrise\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Bitrise\\BitriseServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "opencompanyapp/integration-core": "*"
    }
}
