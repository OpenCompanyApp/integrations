{
    "name": "opencompanyapp/integration-blandai",
    "description": "BlandAI integration for Laravel — make calls, retrieve call details, list calls, and analyze call transcripts.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "blandai", "ai-calls", "telephony", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-blandai": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\BlandAI\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\BlandAI\\BlandAIServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
