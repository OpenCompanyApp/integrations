{
    "name": "opencompanyapp/integration-braintree",
    "description": "Braintree GraphQL API integration for Laravel agents.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": [
        "tools",
        "braintree",
        "graphql",
        "payments",
        "paypal",
        "opencompany"
    ],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-braintree": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Braintree\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Braintree\\BraintreeServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
