{
    "name": "opencompanyapp/integration-brandfetch",
    "description": "Brandfetch integration for Laravel - retrieve brand data, search brands, build logo URLs, and enrich transactions.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "brandfetch", "marketing", "branding", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-brandfetch": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Brandfetch\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Brandfetch\\BrandfetchServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
