{
    "name": "opencompanyapp/integration-braze",
    "description": "Braze integration for Laravel - manage campaigns, Canvases, messaging, users, catalogs, templates, subscriptions, SCIM, and analytics.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": [
        "tools",
        "braze",
        "customer-engagement",
        "messaging",
        "opencompany"
    ],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-braze": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Braze\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Braze\\BrazeServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
