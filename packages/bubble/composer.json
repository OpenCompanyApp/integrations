{
    "name": "opencompanyapp/integration-bubble",
    "description": "Bubble integration for Laravel — list, get, create, update, and delete records from your Bubble application.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "bubble", "no-code", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-bubble": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Bubble\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Bubble\\BubbleServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
