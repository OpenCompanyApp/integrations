{
    "name": "opencompanyapp/integration-bubble",
    "description": "Bubble built-in API integration for Laravel agents: Data API records, Workflow API triggers, and Swagger discovery.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "bubble", "no-code", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-bubble": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Bubble\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Bubble\\BubbleServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
