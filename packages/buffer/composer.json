{
    "name": "opencompanyapp/integration-buffer",
    "description": "Buffer integration for Laravel — manage social media profiles and scheduled updates.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "buffer", "social-media", "marketing", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-buffer": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Buffer\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Buffer\\BufferServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
