{
    "name": "opencompanyapp/integration-bugsnag",
    "description": "Bugsnag error monitoring integration for Laravel — list projects, errors, events, collaborators.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "bugsnag", "error-monitoring", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-bugsnag": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Bugsnag\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Bugsnag\\BugsnagServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
