{
    "name": "opencompanyapp/integration-buildkite",
    "description": "Buildkite integration for Laravel AI agents - organizations, pipelines, builds, jobs, and raw REST helper calls.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "opencompanyapp/integration-core": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Buildkite\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Buildkite\\BuildkiteServiceProvider"
            ]
        }
    },
    "keywords": [
        "tools",
        "buildkite",
        "ci",
        "cd",
        "pipelines",
        "builds",
        "opencompany"
    ]
}
