{
    "name": "opencompanyapp/integration-buymeacoffee",
    "description": "Buy Me a Coffee integration for Laravel — manage supporters, subscriptions, extras, and shops.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "buymeacoffee", "productivity", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-buymeacoffee": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\BuyMeACoffee\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\BuyMeACoffee\\BuyMeACoffeeServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
