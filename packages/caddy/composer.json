{
    "name": "opencompanyapp/integration-caddy",
    "description": "Caddy web server integration for Laravel — manage sites, certificates, and account.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "caddy", "web-server", "productivity", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-caddy": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Caddy\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Caddy\\CaddyServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
