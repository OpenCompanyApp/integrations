{
    "name": "opencompanyapp/integration-cal-com",
    "description": "Cal.com v2 scheduling integration for OpenCompany — event types, bookings, teams, and users.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "cal-com", "cal.com", "scheduling", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-cal-com": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\CalCom\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\CalCom\\CalComServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
