{
    "name": "opencompanyapp/integration-cal",
    "description": "Cal.com API v2 integration for Laravel agents with bookings, event types, profile, and generic REST tools.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "cal", "cal.com", "api-v2", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-cal": "self.version",
        "opencompanyapp/integration-cal-com": "self.version",
        "opencompanyapp/ai-tool-cal-com": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Cal\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Cal\\CalServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
