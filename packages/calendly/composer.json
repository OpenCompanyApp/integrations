{
    "name": "opencompanyapp/integration-calendly",
    "description": "Calendly integration for OpenCompany — event types, bookings, organizations, and users.",
    "license": "MIT",
    "authors": [{"name": "OpenCompany", "homepage": "https://github.com/OpenCompanyApp"}],
    "keywords": ["tools", "calendly", "scheduling", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Calendly\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": ["OpenCompany\\Integrations\\Calendly\\CalendlyServiceProvider"]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
