{
    "name": "opencompanyapp/integration-campaign-monitor",
    "description": "Campaign Monitor integration for Laravel - manage campaigns, clients, lists, subscribers, transactional email, and webhooks.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "campaign-monitor", "email", "newsletter", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-campaign-monitor": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\CampaignMonitor\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\CampaignMonitor\\CampaignMonitorServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
