{
    "name": "opencompanyapp/integration-canva",
    "description": "Canva integration for Laravel — list and create designs, manage folders, upload assets, and get user info.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "canva", "design", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-canva": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Canva\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Canva\\CanvaServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
