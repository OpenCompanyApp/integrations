{
    "name": "opencompanyapp/integration-capsule",
    "description": "Capsule CRM integration for Laravel: manage contacts, opportunities, cases, tasks, tracks, tags, and custom fields.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "capsule", "crm", "sales", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-capsule": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Capsule\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Capsule\\CapsuleServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
