{
    "name": "opencompanyapp/integration-chargebee",
    "description": "Chargebee integration for Laravel — manage subscriptions, customers, and invoices.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "chargebee", "billing", "subscriptions", "payments", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-chargebee": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Chargebee\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Chargebee\\ChargebeeServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
