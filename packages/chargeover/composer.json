{
    "name": "opencompanyapp/integration-chargeover",
    "description": "ChargeOver REST API v3 integration for Laravel — manage customers, subscription packages, invoices and transactions.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "chargeover", "payments", "billing", "subscriptions", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-chargeover": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\ChargeOver\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\ChargeOver\\ChargeOverServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
