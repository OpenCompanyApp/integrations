{
    "name": "opencompanyapp/integration-chargify",
    "description": "Chargify / Maxio Advanced Billing integration for Laravel — manage subscriptions, customers, products, invoices, and site metadata.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "chargify", "payments", "subscriptions", "billing", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-chargify": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Chargify\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Chargify\\ChargifyServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
