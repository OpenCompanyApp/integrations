{
    "name": "opencompanyapp/integration-chartmogul",
    "description": "ChartMogul integration for Laravel — query customers, subscriptions, plans, invoices, and metrics.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "chartmogul", "analytics", "subscriptions", "billing", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-chartmogul": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\ChartMogul\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\ChartMogul\\ChartMogulServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
