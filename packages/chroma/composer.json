{
    "name": "opencompanyapp/integration-chroma",
    "description": "Chroma vector database integration for Laravel — manage collections, store and query embeddings.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "chroma", "vector-database", "embeddings", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-chroma": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Chroma\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Chroma\\ChromaServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
