{
    "name": "opencompanyapp/integration-churnzero",
    "description": "ChurnZero customer success integration for Laravel — manage accounts, contacts, alerts, and usage data.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "churnzero", "customer-success", "sales", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-churnzero": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\ChurnZero\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\ChurnZero\\ChurnZeroServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
