{
    "name": "opencompanyapp/integration-circleci",
    "description": "CircleCI integration for Laravel — manage pipelines, workflows, and projects.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "circleci", "ci-cd", "devtools", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-circleci": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\CircleCI\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\CircleCI\\CircleCIServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
