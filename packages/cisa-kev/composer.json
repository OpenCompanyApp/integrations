{
    "name": "opencompanyapp/integration-cisa-kev",
    "description": "CISA Known Exploited Vulnerabilities catalog integration for Laravel AI agents - JSON catalog, filtered search, CVE lookup, recent additions, schema, CSV, and license.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "opencompanyapp/integration-core": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\CisaKev\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\CisaKev\\CisaKevServiceProvider"
            ]
        }
    },
    "keywords": [
        "tools",
        "cisa",
        "kev",
        "known-exploited-vulnerabilities",
        "cve",
        "security",
        "opencompany"
    ]
}
