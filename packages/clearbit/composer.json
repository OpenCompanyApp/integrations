{
    "name": "opencompanyapp/integration-clearbit",
    "description": "Clearbit enrichment integration for Laravel — enrich people and companies, reveal visitor identity, prospect by role.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "clearbit", "enrichment", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-clearbit": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Clearbit\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Clearbit\\ClearbitServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
