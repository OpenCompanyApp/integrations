{
    "name": "opencompanyapp/integration-clerk",
    "description": "Clerk authentication integration for Laravel - manage users, sessions, organizations, invitations, and identity.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "clerk", "authentication", "identity", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-clerk": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Clerk\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Clerk\\ClerkServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
