{
    "name": "opencompanyapp/integration-clinicaltrials-gov",
    "description": "ClinicalTrials.gov API v2 integration for Laravel AI agents.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "opencompanyapp/integration-core": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\ClinicalTrialsGov\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\ClinicalTrialsGov\\ClinicalTrialsGovServiceProvider"
            ]
        }
    },
    "keywords": [
        "tools",
        "clinicaltrials",
        "clinicaltrials.gov",
        "clinical-trials",
        "nih",
        "research",
        "opencompany"
    ]
}
