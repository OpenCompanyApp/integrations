{
    "name": "opencompanyapp/integration-close",
    "description": "Close CRM integration for Laravel — manage leads, contacts, activities, and tasks.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "close", "crm", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-close": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Close\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Close\\CloseServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
