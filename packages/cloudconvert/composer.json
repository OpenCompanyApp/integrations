{
    "name": "opencompanyapp/integration-cloudconvert",
    "description": "CloudConvert integration for Laravel - manage jobs, tasks, operations, webhooks, signed URLs, and file conversions.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": [
        "tools",
        "cloudconvert",
        "files",
        "conversion",
        "opencompany"
    ],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-cloudconvert": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\CloudConvert\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\CloudConvert\\CloudConvertServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
