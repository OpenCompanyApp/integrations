{
    "name": "opencompanyapp/integration-cloudflare",
    "description": "Cloudflare integration for Laravel — manage zones, DNS records, page rules, and analytics.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "cloudflare", "dns", "cloud", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-cloudflare": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Cloudflare\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Cloudflare\\CloudflareServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
