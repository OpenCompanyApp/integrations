{
    "name": "opencompanyapp/integration-cloudinary",
    "description": "Cloudinary integration for Laravel — upload, list, get, and delete media resources and folders.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "cloudinary", "media", "images", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-cloudinary": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Cloudinary\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Cloudinary\\CloudinaryServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
