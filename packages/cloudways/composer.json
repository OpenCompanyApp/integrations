{
    "name": "opencompanyapp/integration-cloudways",
    "description": "Cloudways integration for Laravel — manage servers, applications, domains, and projects on Cloudways managed hosting.",
    "license": "MIT",
    "authors": [{ "name": "OpenCompany", "homepage": "https://github.com/OpenCompanyApp" }],
    "keywords": ["tools", "cloudways", "hosting", "managed", "servers", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": { "opencompanyapp/ai-tool-cloudways": "self.version" },
    "autoload": {
        "psr-4": { "OpenCompany\\Integrations\\Cloudways\\": "src/" }
    },
    "extra": {
        "laravel": {
            "providers": ["OpenCompany\\Integrations\\Cloudways\\CloudwaysServiceProvider"]
        }
    }
}
