{
    "name": "opencompanyapp/integration-cockroachdb",
    "description": "CockroachDB Cloud integration for Laravel agents with generated Cloud API coverage.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "cockroachdb", "database", "cloud", "clusters", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-cockroachdb": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\CockroachDb\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\CockroachDb\\CockroachDbServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
