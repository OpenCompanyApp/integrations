{
    "name": "opencompanyapp/integration-coda",
    "description": "Coda integration for Laravel — manage docs, tables, rows, columns, and pages.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "coda", "documents", "spreadsheets", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-coda": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Coda\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Coda\\CodaServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
