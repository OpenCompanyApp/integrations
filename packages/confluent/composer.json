{
    "name": "opencompanyapp/integration-confluent",
    "description": "Confluent Cloud integration for Laravel - generated coverage of the official Confluent Cloud REST APIs.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": [
        "tools",
        "confluent",
        "kafka",
        "schema-registry",
        "flink",
        "streaming",
        "opencompany"
    ],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-confluent": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Confluent\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Confluent\\ConfluentServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
