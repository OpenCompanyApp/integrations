{
    "name": "opencompanyapp/integration-confluent",
    "description": "Confluent Cloud Kafka integration for Laravel — manage topics, clusters, environments, and user info.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "confluent", "kafka", "messaging", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-confluent": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Confluent\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Confluent\\ConfluentServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
