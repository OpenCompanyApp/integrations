{
    "name": "opencompanyapp/integration-constant-contact",
    "description": "Constant Contact integration for Laravel — manage contacts and contact lists.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "constant-contact", "email", "marketing", "contacts", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-constant-contact": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\ConstantContact\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\ConstantContact\\ConstantContactServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
