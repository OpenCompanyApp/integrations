{
    "name": "opencompanyapp/integration-contabo",
    "description": "Contabo integration for Laravel — manage cloud VPS instances, snapshots, images, networks, and SSH keys.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "contabo", "cloud", "vps", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-contabo": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Contabo\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Contabo\\ContaboServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
