{
    "name": "opencompanyapp/integration-convertkit",
    "description": "Kit (ConvertKit) integration for Laravel - manage subscribers, tags, forms, broadcasts, sequences, commerce, and webhooks.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "convertkit", "email", "newsletter", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-convertkit": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\ConvertKit\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\ConvertKit\\ConvertKitServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
