{
    "name": "opencompanyapp/integration-convex",
    "description": "Convex backend platform integration for OpenCompany — tables, documents, queries, and mutations.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "convex", "backend", "database", "data", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-convex": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Convex\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Convex\\ConvexServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
