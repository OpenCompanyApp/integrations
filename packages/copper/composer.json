{
    "name": "opencompanyapp/integration-copper",
    "description": "Copper CRM integration for Laravel: manage people, companies, opportunities, leads, projects, tasks, activities, and webhooks.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "copper", "crm", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-copper": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Copper\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Copper\\CopperServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
