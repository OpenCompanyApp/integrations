{
    "name": "opencompanyapp/integration-crisp",
    "description": "Crisp REST API integration for Laravel agents using the official node-crisp-api operation surface.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": [
        "tools",
        "crisp",
        "messaging",
        "helpdesk",
        "opencompany"
    ],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0"
    },
    "replace": {
        "opencompanyapp/ai-tool-crisp": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Crisp\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Crisp\\CrispServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
