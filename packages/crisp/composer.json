{
    "name": "opencompanyapp/integration-crisp",
    "description": "Crisp integration for Laravel — manage conversations, contacts, campaigns, and messaging.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "crisp", "chat", "messaging", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-crisp": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Crisp\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Crisp\\CrispServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
