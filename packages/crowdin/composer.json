{
    "name": "opencompanyapp/integration-crowdin",
    "description": "Crowdin localization platform integration for Laravel — manage projects, strings, translations, and languages.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "crowdin", "localization", "translations", "productivity", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-crowdin": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Crowdin\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Crowdin\\CrowdinServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
