{
    "name": "opencompanyapp/integration-cursor",
    "description": "Cursor IDE integration for Laravel — list workspaces, members, and extensions.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "cursor", "ide", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-cursor": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Cursor\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Cursor\\CursorServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
