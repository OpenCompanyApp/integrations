{
    "name": "opencompanyapp/integration-customerio",
    "description": "Customer.io integration for Laravel — identify customers, track events, manage segments, campaigns, and newsletters.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "customerio", "email", "marketing", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-customerio": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\CustomerIO\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\CustomerIO\\CustomerIOServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
