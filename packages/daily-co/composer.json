{
    "name": "opencompanyapp/integration-daily-co",
    "description": "Daily.co video API integration for Laravel covering rooms, meetings, tokens, recordings, transcripts, domain config, presence, logs, phone numbers, and webhooks.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "daily-co", "communication", "video", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0"
    },
    "replace": {
        "opencompanyapp/ai-tool-daily-co": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\DailyCo\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\DailyCo\\DailyCoServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
