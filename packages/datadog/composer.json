{
    "name": "opencompanyapp/integration-datadog",
    "description": "Datadog integration for Laravel — manage monitors, query metrics, view dashboards, and post events.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "datadog", "monitoring", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-datadog": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Datadog\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Datadog\\DatadogServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
