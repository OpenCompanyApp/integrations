{
    "name": "opencompanyapp/integration-deepl",
    "description": "DeepL translation integration for Laravel — translate text, manage glossaries, list languages, and check usage.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "deepl", "translation", "ai", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-deepl": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\DeepL\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\DeepL\\DeepLServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
