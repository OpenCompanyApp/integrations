{
    "name": "opencompanyapp/integration-deps-dev",
    "description": "deps.dev integration for Laravel AI agents - package versions, version metadata, requirements, dependencies, projects, project package mappings, advisories, and query lookup.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "opencompanyapp/integration-core": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\DepsDev\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\DepsDev\\DepsDevServiceProvider"
            ]
        }
    },
    "keywords": [
        "tools",
        "deps-dev",
        "open-source-insights",
        "dependencies",
        "packages",
        "advisories",
        "supply-chain",
        "opencompany"
    ]
}
