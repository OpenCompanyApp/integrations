{
    "name": "opencompanyapp/integration-dialpad",
    "description": "Dialpad API integration for Laravel agents.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": [
        "tools",
        "dialpad",
        "communications",
        "calls",
        "sms",
        "opencompany"
    ],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-dialpad": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Dialpad\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Dialpad\\DialpadServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
