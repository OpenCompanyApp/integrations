{
    "name": "opencompanyapp/integration-digitalocean",
    "description": "DigitalOcean integration for Laravel — manage droplets, domains, spaces, and Kubernetes clusters.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "digitalocean", "cloud", "droplets", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-digitalocean": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\DigitalOcean\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\DigitalOcean\\DigitalOceanServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
