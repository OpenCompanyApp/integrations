{
    "name": "opencompanyapp/integration-docker",
    "description": "Docker Hub integration for Laravel — manage repositories, tags, and organizations.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "docker", "docker-hub", "containers", "productivity", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-docker": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Docker\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Docker\\DockerServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
