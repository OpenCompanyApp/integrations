{
    "name": "opencompanyapp/integration-docusign",
    "description": "DocuSign integration for Laravel — manage envelopes, templates, and documents.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "docusign", "esignature", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-docusign": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\DocuSign\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\DocuSign\\DocuSignServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
