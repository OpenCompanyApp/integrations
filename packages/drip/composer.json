{
    "name": "opencompanyapp/integration-drip",
    "description": "Drip email marketing integration for Laravel — manage subscribers, campaigns, and workflows.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "drip", "email", "marketing", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-drip": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Drip\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Drip\\DripServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
