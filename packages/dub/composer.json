{
    "name": "opencompanyapp/integration-dub",
    "description": "Dub API integration for Laravel covering links, analytics, domains, tags, partners, and tracking.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "dub", "links", "analytics", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-dub": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Dub\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Dub\\DubServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
