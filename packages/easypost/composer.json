{
    "name": "opencompanyapp/integration-easypost",
    "description": "EasyPost integration for Laravel AI agents - addresses, shipments, trackers, orders, batches, pickups, refunds, insurance, carrier accounts, webhooks, reports, and raw API calls.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\EasyPost\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\EasyPost\\EasyPostServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
