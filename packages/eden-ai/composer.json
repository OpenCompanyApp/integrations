{
    "name": "opencompanyapp/integration-eden-ai",
    "description": "Eden AI integration for Laravel with V3 chat, Universal AI, model discovery, files, async jobs, and legacy V2 helpers.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "eden-ai", "ai", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-eden-ai": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\EdenAi\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\EdenAi\\EdenAiServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
