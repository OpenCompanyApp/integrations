{
    "name": "opencompanyapp/integration-elastic-email",
    "description": "Elastic Email integration for Laravel — send transactional emails, manage templates and contacts.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "elastic-email", "email", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-elastic-email": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\ElasticEmail\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\ElasticEmail\\ElasticEmailServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
