{
    "name": "opencompanyapp/integration-elastic",
    "description": "Elasticsearch integration for Laravel — search, index, and manage documents and indices.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "elasticsearch", "elastic", "search", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-elastic": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Elastic\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Elastic\\ElasticServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
