{
    "name": "opencompanyapp/integration-eleven-labs",
    "description": "ElevenLabs integration for Laravel — text-to-speech, sound generation, voice and model management.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "elevenlabs", "ai", "text-to-speech", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-eleven-labs": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\ElevenLabs\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\ElevenLabs\\ElevenLabsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
