{
    "name": "opencompanyapp/integration-email-octopus",
    "description": "EmailOctopus integration for Laravel - lists, contacts, fields, tags, campaigns, reports, and automations.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "emailoctopus", "email", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-email-octopus": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\EmailOctopus\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\EmailOctopus\\EmailOctopusServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
