{
    "name": "opencompanyapp/integration-eventbrite",
    "description": "Eventbrite integration for Laravel — manage events, attendees, and venues.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "eventbrite", "events", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-eventbrite": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Eventbrite\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Eventbrite\\EventbriteServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
