{
    "name": "opencompanyapp/integration-exchangerate",
    "description": "Currency exchange rate integration for Laravel — 340 fiat, crypto, and metal conversions.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "exchange-rate", "currency", "forex", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-exchangerate": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\ExchangeRate\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\ExchangeRate\\ExchangeRateServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
