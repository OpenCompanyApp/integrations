{
    "name": "opencompanyapp/integration-facebook",
    "description": "Facebook Graph API integration for Laravel — manage pages, posts, and insights.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "facebook", "social", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-facebook": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Facebook\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Facebook\\FacebookServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
