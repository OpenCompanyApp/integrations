{
    "name": "opencompanyapp/integration-fal",
    "description": "fal.ai integration for Laravel — AI media generation, model listing, and file management.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "fal", "fal.ai", "ai", "media", "generation", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-fal": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Fal\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Fal\\FalServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
