{
    "name": "opencompanyapp/integration-fathom",
    "description": "Fathom Analytics integration for Laravel - manage sites, events, milestones, reports, and current visitors.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "fathom", "analytics", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-fathom": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Fathom\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Fathom\\FathomServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
