{
    "name": "opencompanyapp/integration-fellow",
    "description": "Fellow Developer API integration for Laravel: notes, action items, recordings, and webhooks.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "fellow", "meetings", "productivity", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-fellow": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Fellow\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Fellow\\FellowServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
