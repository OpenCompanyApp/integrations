{
    "name": "opencompanyapp/integration-firecrawl",
    "description": "Firecrawl integration for Laravel — scrape, crawl, map, and extract web content.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "firecrawl", "scraping", "web-crawling", "extraction", "ai", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-firecrawl": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Firecrawl\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Firecrawl\\FirecrawlServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
