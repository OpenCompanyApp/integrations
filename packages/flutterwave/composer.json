{
    "name": "opencompanyapp/integration-flutterwave",
    "description": "Flutterwave payments integration for Laravel — manage transactions, customers, and bank lookups.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "flutterwave", "payments", "finance", "africa", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-flutterwave": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Flutterwave\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Flutterwave\\FlutterwaveServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
