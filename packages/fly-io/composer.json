{
    "name": "opencompanyapp/integration-fly-io",
    "description": "Fly.io integration for Laravel — manage apps, machines, volumes, and platform resources.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "fly-io", "cloud", "machines", "apps", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-fly-io": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\FlyIo\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\FlyIo\\FlyIoServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
