{
    "name": "opencompanyapp/integration-formstack",
    "description": "Formstack integration for Laravel — manage forms, submissions, and folders.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "formstack", "forms", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-formstack": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Formstack\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Formstack\\FormstackServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
