{
    "name": "opencompanyapp/integration-freeagent",
    "description": "FreeAgent accounting integration for Laravel — manage invoices, contacts, projects and expenses.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "freeagent", "accounting", "invoices", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-freeagent": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\FreeAgent\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\FreeAgent\\FreeAgentServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
