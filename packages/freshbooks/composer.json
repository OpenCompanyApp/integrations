{
    "name": "opencompanyapp/integration-freshbooks",
    "description": "FreshBooks accounting integration for Laravel — manage invoices, clients, projects, and payments.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "freshbooks", "accounting", "invoices", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-freshbooks": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\FreshBooks\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\FreshBooks\\FreshBooksServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
