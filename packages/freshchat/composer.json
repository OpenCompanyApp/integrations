{
    "name": "opencompanyapp/integration-freshchat",
    "description": "Freshchat integration for Laravel — manage conversations, agents, and groups.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "freshchat", "support", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-freshchat": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Freshchat\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Freshchat\\FreshchatServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
