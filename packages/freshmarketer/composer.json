{
    "name": "opencompanyapp/integration-freshmarketer",
    "description": "Freshmarketer (Freshworks) integration for Laravel — manage campaigns, segments, and users.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "freshmarketer", "marketing", "freshworks", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-freshmarketer": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Freshmarketer\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Freshmarketer\\FreshmarketerServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
