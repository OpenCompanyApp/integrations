{
    "name": "opencompanyapp/integration-freshsales",
    "description": "Freshsales CRM integration for Laravel — manage contacts, deals, and accounts.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "freshsales", "crm", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-freshsales": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Freshsales\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Freshsales\\FreshsalesServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
