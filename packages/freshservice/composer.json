{
    "name": "opencompanyapp/integration-freshservice",
    "description": "Freshservice ITSM integration for Laravel — manage tickets, agents, and assets.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "freshservice", "itsm", "tickets", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-freshservice": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Freshservice\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Freshservice\\FreshserviceServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
