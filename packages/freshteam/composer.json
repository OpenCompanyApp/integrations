{
    "name": "opencompanyapp/integration-freshteam",
    "description": "Freshteam HR integration for Laravel — manage candidates, job postings, employees, and user info.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "freshteam", "hr", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-freshteam": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Freshteam\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Freshteam\\FreshteamServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
