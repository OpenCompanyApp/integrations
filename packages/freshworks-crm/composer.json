{
    "name": "opencompanyapp/integration-freshworks-crm",
    "description": "Freshworks CRM integration for Laravel: manage contacts, accounts, deals, tasks, appointments, notes, activities, and metadata.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "freshworks", "crm", "sales", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-freshworks-crm": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\FreshworksCrm\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\FreshworksCrm\\FreshworksCrmServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
