{
    "name": "opencompanyapp/integration-gainsight",
    "description": "Gainsight integration for Laravel — list companies, users, and surveys from the Gainsight customer success platform.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "gainsight", "customer-success", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-gainsight": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Gainsight\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Gainsight\\GainsightServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
