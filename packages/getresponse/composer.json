{
    "name": "opencompanyapp/integration-getresponse",
    "description": "GetResponse integration for Laravel — manage contacts, campaigns, and newsletters.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "getresponse", "email", "marketing", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-getresponse": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\GetResponse\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\GetResponse\\GetResponseServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
