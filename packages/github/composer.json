{
    "name": "opencompanyapp/integration-github",
    "description": "GitHub integration for OpenCompany — repos, issues, pull requests, commits, releases, and more.",
    "license": "MIT",
    "authors": [{"name": "OpenCompany", "homepage": "https://github.com/OpenCompanyApp"}],
    "keywords": ["tools", "github", "git", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "autoload": {
        "psr-4": {"OpenCompany\\Integrations\\GitHub\\": "src/"}
    },
    "extra": {
        "laravel": {
            "providers": ["OpenCompany\\Integrations\\GitHub\\GitHubServiceProvider"]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
