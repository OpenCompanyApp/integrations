{
    "name": "opencompanyapp/integration-gong",
    "description": "Gong integration for Laravel — list calls, users, deals, and interactions.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "gong", "revenue-intelligence", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-gong": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Gong\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Gong\\GongServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
