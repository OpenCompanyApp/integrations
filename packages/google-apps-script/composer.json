{
    "name": "opencompanyapp/integration-google-apps-script",
    "description": "Google Apps Script integration for Laravel AI agents - script projects, content, deployments, versions, metrics, processes, and function execution.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "opencompanyapp/integration-core": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\GoogleAppsScript\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\GoogleAppsScript\\GoogleAppsScriptServiceProvider"
            ]
        }
    },
    "keywords": [
        "tools",
        "google",
        "apps-script",
        "automation",
        "workspace",
        "opencompany"
    ]
}
