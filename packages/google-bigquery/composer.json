{
    "name": "opencompanyapp/integration-google-bigquery",
    "description": "Google BigQuery integration for Laravel AI agents - datasets, tables, jobs, query results, models, routines, row access policies, table data, projects, and IAM.",
    "type": "library",
    "license": "MIT",
    "authors": [{"name": "OpenCompany", "homepage": "https://github.com/OpenCompanyApp"}],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "opencompanyapp/integration-core": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\GoogleBigQuery\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\GoogleBigQuery\\GoogleBigQueryServiceProvider"
            ]
        }
    },
    "keywords": ["tools", "google", "bigquery", "warehouse", "analytics", "sql", "opencompany"]
}
