{
    "name": "opencompanyapp/integration-google-calendar",
    "description": "Google Calendar integration for Laravel AI agents - generated Calendar API v3 coverage for events, calendars, ACLs, settings, free/busy, and watch channels.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "opencompanyapp/integration-core": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\GoogleCalendar\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\GoogleCalendar\\GoogleCalendarServiceProvider"
            ]
        }
    },
    "keywords": [
        "tools",
        "google",
        "calendar",
        "events",
        "workspace",
        "opencompany"
    ]
}
