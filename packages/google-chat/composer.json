{
    "name": "opencompanyapp/integration-google-chat",
    "description": "Google Chat integration for Laravel AI agents - generated Chat API v1 coverage for spaces, messages, members, reactions, custom emojis, user read state, sections, and media uploads.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "opencompanyapp/integration-core": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\GoogleChat\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\GoogleChat\\GoogleChatServiceProvider"
            ]
        }
    },
    "keywords": [
        "tools",
        "google",
        "chat",
        "workspace",
        "messages",
        "opencompany"
    ]
}
