{
    "name": "opencompanyapp/integration-google-classroom",
    "description": "Google Classroom integration for Laravel AI agents - courses, coursework, submissions, guardians, invitations, registrations, topics, rosters, and add-on attachments.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "opencompanyapp/integration-core": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\GoogleClassroom\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\GoogleClassroom\\GoogleClassroomServiceProvider"
            ]
        }
    },
    "keywords": [
        "tools",
        "google",
        "classroom",
        "education",
        "workspace",
        "opencompany"
    ]
}
