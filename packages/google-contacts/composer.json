{
    "name": "opencompanyapp/integration-google-contacts",
    "description": "Google Contacts integration for Laravel AI agents - generated People API v1 coverage for people, connections, other contacts, contact groups, members, and photos.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "opencompanyapp/integration-core": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\GoogleContacts\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\GoogleContacts\\GoogleContactsServiceProvider"
            ]
        }
    },
    "keywords": [
        "tools",
        "google",
        "contacts",
        "people",
        "workspace",
        "opencompany"
    ]
}
