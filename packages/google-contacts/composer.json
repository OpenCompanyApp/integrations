{
    "name": "opencompanyapp/integration-google-contacts",
    "description": "Google Contacts (People API) integration for Laravel — list connections, manage contacts and contact groups, access other contacts.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "google", "contacts", "people-api", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-google-contacts": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\GoogleContacts\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\GoogleContacts\\GoogleContactsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
