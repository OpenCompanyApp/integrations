{
    "name": "opencompanyapp/integration-google-data-manager",
    "description": "Google Data Manager integration for first-party conversion event and audience ingestion.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "google", "data-manager", "advertising", "audiences", "conversions", "opencompany"],
