{
    "name": "opencompanyapp/integration-google-docs",
    "description": "Google Docs integration for Laravel AI agents - generated Docs API v1 coverage for document create, get, and batchUpdate.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "opencompanyapp/integration-core": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\GoogleDocs\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\GoogleDocs\\GoogleDocsServiceProvider"
            ]
        }
    },
    "keywords": [
        "tools",
        "google",
        "docs",
        "workspace",
        "documents",
        "opencompany"
    ]
}
