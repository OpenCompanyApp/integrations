{
    "name": "opencompanyapp/integration-google-drive-activity",
    "description": "Google Drive Activity integration for Laravel AI agents - query audit/activity events for Drive items and folders.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "opencompanyapp/integration-core": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\GoogleDriveActivity\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\GoogleDriveActivity\\GoogleDriveActivityServiceProvider"
            ]
        }
    },
    "keywords": [
        "tools",
        "google",
        "drive-activity",
        "audit",
        "workspace",
        "opencompany"
    ]
}
