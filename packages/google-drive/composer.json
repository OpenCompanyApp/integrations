{
    "name": "opencompanyapp/integration-google-drive",
    "description": "Google Drive integration for Laravel AI agents - generated Drive API v3 coverage for files, permissions, comments, replies, drives, changes, revisions, approvals, apps, channels, operations, and uploads.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "opencompanyapp/integration-core": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\GoogleDrive\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\GoogleDrive\\GoogleDriveServiceProvider"
            ]
        }
    },
    "keywords": [
        "tools",
        "google",
        "drive",
        "files",
        "workspace",
        "opencompany"
    ]
}
