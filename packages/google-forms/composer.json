{
    "name": "opencompanyapp/integration-google-forms",
    "description": "Google Forms integration for Laravel AI agents - generated Forms API v1 coverage for forms, responses, batch updates, publish settings, and watches.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "opencompanyapp/integration-core": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\GoogleForms\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\GoogleForms\\GoogleFormsServiceProvider"
            ]
        }
    },
    "keywords": [
        "tools",
        "google",
        "forms",
        "workspace",
        "opencompany"
    ]
}
