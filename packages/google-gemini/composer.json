{
    "name": "opencompanyapp/integration-google-gemini",
    "description": "Google Gemini API integration for Laravel AI agents - generated Gemini API v1beta coverage for models, files, batches, caches, corpora, tuned models, generated files, and file search stores.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "opencompanyapp/integration-core": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\GoogleGemini\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\GoogleGemini\\GeminiServiceProvider"
            ]
        }
    },
    "keywords": [
        "tools",
        "google",
        "gemini",
        "ai",
        "generative-language",
        "opencompany"
    ]
}
