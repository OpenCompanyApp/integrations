{
    "name": "opencompanyapp/integration-google-meet",
    "description": "Google Meet integration for Laravel AI agents - meeting spaces, conference records, participants, recordings, transcripts, and smart notes.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "opencompanyapp/integration-core": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\GoogleMeet\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\GoogleMeet\\GoogleMeetServiceProvider"
            ]
        }
    },
    "keywords": [
        "tools",
        "google",
        "meet",
        "meetings",
        "workspace",
        "opencompany"
    ]
}
