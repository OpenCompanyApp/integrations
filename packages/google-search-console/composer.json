{
    "name": "opencompanyapp/integration-google-search-console",
    "description": "Google Search Console integration for Laravel AI agents - generated Search Console API v1 coverage for sites, sitemaps, search analytics, URL inspection, and mobile friendly tests.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "opencompanyapp/integration-core": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\GoogleSearchConsole\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\GoogleSearchConsole\\GoogleSearchConsoleServiceProvider"
            ]
        }
    },
    "keywords": [
        "tools",
        "google",
        "search-console",
        "seo",
        "webmasters",
        "opencompany"
    ]
}
