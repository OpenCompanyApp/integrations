{
    "name": "opencompanyapp/integration-google-slides",
    "description": "Google Slides integration for Laravel AI agents - generated Slides API v1 coverage for presentations, batch updates, pages, and thumbnails.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "opencompanyapp/integration-core": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\GoogleSlides\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\GoogleSlides\\GoogleSlidesServiceProvider"
            ]
        }
    },
    "keywords": [
        "tools",
        "google",
        "slides",
        "workspace",
        "presentations",
        "opencompany"
    ]
}
