{
    "name": "opencompanyapp/integration-google-tasks",
    "description": "Google Tasks integration for Laravel AI agents - generated Tasks API v1 coverage for task lists and tasks.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "opencompanyapp/integration-core": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\GoogleTasks\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\GoogleTasks\\GoogleTasksServiceProvider"
            ]
        }
    },
    "keywords": [
        "tools",
        "google",
        "tasks",
        "workspace",
        "opencompany"
    ]
}
