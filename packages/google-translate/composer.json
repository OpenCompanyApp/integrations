{
    "name": "opencompanyapp/integration-google-translate",
    "description": "Google Translate integration for Laravel AI agents - generated Cloud Translation API v3 coverage for translation, language detection, documents, glossaries, datasets, models, adaptive MT, and operations.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "opencompanyapp/integration-core": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\GoogleTranslate\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\GoogleTranslate\\GoogleTranslateServiceProvider"
            ]
        }
    },
    "keywords": [
        "tools",
        "google",
        "translate",
        "translation",
        "cloud",
        "ai",
        "opencompany"
    ]
}
