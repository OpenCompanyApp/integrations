{
    "name": "opencompanyapp/integration-google-workspace-admin",
    "description": "Google Workspace Admin integration for Laravel AI agents - users, groups, org units, domains, roles, devices, tokens, aliases, schemas, and Directory resources.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "opencompanyapp/integration-core": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\GoogleWorkspaceAdmin\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\GoogleWorkspaceAdmin\\GoogleWorkspaceAdminServiceProvider"
            ]
        }
    },
    "keywords": [
        "tools",
        "google",
        "workspace",
        "admin",
        "directory",
        "opencompany"
    ]
}
