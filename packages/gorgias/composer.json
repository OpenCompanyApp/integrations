{
    "name": "opencompanyapp/integration-gorgias",
    "description": "Gorgias (gorgias.com) integration for Laravel — manage tickets, customers, and satisfaction surveys.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "gorgias", "productivity", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-gorgias": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Gorgias\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Gorgias\\GorgiasServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
