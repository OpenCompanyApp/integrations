{
    "name": "opencompanyapp/integration-granola",
    "description": "Granola Enterprise API integration for Laravel - list notes, get note details, and list folders.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "granola", "meetings", "notes", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-granola": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Granola\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Granola\\GranolaServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
