{
    "name": "opencompanyapp/integration-groq",
    "description": "Groq integration for Laravel: chat completions, responses, audio, models, batches, files, and fine tuning.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "groq", "ai", "inference", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-groq": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Groq\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Groq\\GroqServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
