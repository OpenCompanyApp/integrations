{
    "name": "opencompanyapp/integration-gumroad",
    "description": "Gumroad integration for Laravel — manage products, sales, subscribers, and offers.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "gumroad", "ecommerce", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-gumroad": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Gumroad\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Gumroad\\GumroadServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
