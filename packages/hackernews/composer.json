{
    "name": "opencompanyapp/integration-hackernews",
    "description": "Hacker News integration for Laravel — fetch stories, items, and user profiles from the HN API.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "hackernews", "news", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-hackernews": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\HackerNews\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\HackerNews\\HackerNewsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
