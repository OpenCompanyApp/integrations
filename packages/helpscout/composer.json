{
    "name": "opencompanyapp/integration-helpscout",
    "description": "HelpScout integration for Laravel — manage conversations, customers, and mailboxes.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "helpscout", "support", "helpdesk", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-helpscout": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\HelpScout\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\HelpScout\\HelpScoutServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
