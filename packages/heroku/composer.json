{
    "name": "opencompanyapp/integration-heroku",
    "description": "Heroku integration for Laravel — manage apps, dynos, addons, domains, and collaborators.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "heroku", "cloud", "platform", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-heroku": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Heroku\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Heroku\\HerokuServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
