{
    "name": "opencompanyapp/integration-hetzner",
    "description": "Hetzner Cloud integration for Laravel agents with generated Cloud API coverage.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "hetzner", "cloud", "servers", "productivity", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-hetzner": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Hetzner\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Hetzner\\HetznerServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
