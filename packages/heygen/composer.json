{
    "name": "opencompanyapp/integration-heygen",
    "description": "HeyGen AI video generation integration for Laravel — create videos, manage avatars, voices, and templates.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "heygen", "ai", "video", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-heygen": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\HeyGen\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\HeyGen\\HeyGenServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
