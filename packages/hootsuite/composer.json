{
    "name": "opencompanyapp/integration-hootsuite",
    "description": "Hootsuite integration for Laravel — manage messages, social profiles, and team members.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "hootsuite", "social-media", "marketing", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-hootsuite": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Hootsuite\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Hootsuite\\HootsuiteServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
