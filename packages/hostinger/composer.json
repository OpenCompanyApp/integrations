{
    "name": "opencompanyapp/integration-hostinger",
    "description": "Hostinger integration for Laravel — manage servers, domains, DNS records, and SSL certificates.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "hostinger", "hosting", "servers", "domains", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-hostinger": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Hostinger\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Hostinger\\HostingerServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
