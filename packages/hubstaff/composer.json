{
    "name": "opencompanyapp/integration-hubstaff",
    "description": "Hubstaff integration for Laravel — list time entries, manage projects, and view organizations.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "hubstaff", "productivity", "time-tracking", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-hubstaff": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Hubstaff\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Hubstaff\\HubstaffServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
