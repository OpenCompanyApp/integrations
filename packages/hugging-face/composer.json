{
    "name": "opencompanyapp/integration-hugging-face",
    "description": "Hugging Face integration for Laravel — list models, datasets, spaces, run inference, and manage your account.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "hugging-face", "ai", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-hugging-face": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\HuggingFace\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\HuggingFace\\HuggingFaceServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
