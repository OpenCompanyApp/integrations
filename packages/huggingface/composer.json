{
    "name": "opencompanyapp/integration-huggingface",
    "description": "Hugging Face AI platform integration for Laravel — list models, datasets, spaces, and manage your account.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "huggingface", "ai", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-huggingface": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Huggingface\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Huggingface\\HuggingfaceServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
