{
    "name": "opencompanyapp/integration-immigrant",
    "description": "Immigrant migration tool integration for Laravel — manage immigration applications, documents, and statuses.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "immigrant", "productivity", "immigration", "migration", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-immigrant": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Immigrant\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Immigrant\\ImmigrantServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
