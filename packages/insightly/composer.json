{
    "name": "opencompanyapp/integration-insightly",
    "description": "Insightly CRM integration for Laravel with contacts, organizations, leads, opportunities, projects, tasks, events, teams, and metadata.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "insightly", "crm", "sales", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-insightly": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Insightly\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Insightly\\InsightlyServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
