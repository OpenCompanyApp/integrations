{
    "name": "opencompanyapp/integration-instagram",
    "description": "Instagram integration for Laravel — manage media, comments, and insights via the Instagram Graph API.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "instagram", "social-media", "marketing", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-instagram": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Instagram\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Instagram\\InstagramServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
