{
    "name": "opencompanyapp/integration-instantly",
    "description": "Instantly.ai integration for Laravel — cold email outreach, campaigns, leads, analytics, and deliverability.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "instantly", "email", "outreach", "campaigns", "leads", "analytics", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-instantly": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Instantly\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Instantly\\InstantlyServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
