{
    "name": "opencompanyapp/integration-invoiceninja",
    "description": "Invoice Ninja integration for Laravel: manage invoicing, billing, clients, expenses, projects and related records.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "invoiceninja", "invoicing", "accounting", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-invoiceninja": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\InvoiceNinja\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\InvoiceNinja\\InvoiceNinjaServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
