{
    "name": "opencompanyapp/integration-ionos",
    "description": "IONOS Cloud integration for Laravel — manage servers, volumes, LANs, NICs, and images.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "ionos", "cloud", "servers", "volumes", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-ionos": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Ionos\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Ionos\\IonosServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
