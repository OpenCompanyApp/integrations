{
    "name": "opencompanyapp/integration-ipstack",
    "description": "IPstack geolocation integration for Laravel: standard, bulk, and requester IP lookups.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "ipstack", "geolocation", "ip", "data", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-ipstack": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Ipstack\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Ipstack\\IpstackServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
