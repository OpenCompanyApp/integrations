{
    "name": "opencompanyapp/integration-jinaai",
    "description": "Jina AI integration for Laravel — search, read, ground, embeddings, and rerank.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "jinaai", "ai", "search", "embeddings", "rerank", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-jinaai": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\JinaAI\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\JinaAI\\JinaAIServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
