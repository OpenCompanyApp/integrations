{
    "name": "opencompanyapp/integration-kafka",
    "description": "Apache Kafka (Confluent Cloud) integration for Laravel — manage topics, clusters, producers, and user info.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "kafka", "confluent", "messaging", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-kafka": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Kafka\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Kafka\\KafkaServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
