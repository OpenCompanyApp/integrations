{
    "name": "opencompanyapp/integration-kajabi",
    "description": "Kajabi integration for Laravel — manage offers, products, members, and account details.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "kajabi", "productivity", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-kajabi": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Kajabi\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Kajabi\\KajabiServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
