{
    "name": "opencompanyapp/integration-kamatera",
    "description": "Kamatera integration for Laravel — manage cloud servers, networks, images, and datacenters.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "kamatera", "cloud", "servers", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-kamatera": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Kamatera\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Kamatera\\KamateraServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
