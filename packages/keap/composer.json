{
    "name": "opencompanyapp/integration-keap",
    "description": "Keap CRM integration for Laravel — manage contacts, opportunities, and tags.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "keap", "crm", "sales", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-keap": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Keap\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Keap\\KeapServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
