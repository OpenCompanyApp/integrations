{
    "name": "opencompanyapp/integration-kimai",
    "description": "Kimai time-tracking integration for Laravel — manage timesheets, projects, and customers.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "kimai", "time-tracking", "productivity", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-kimai": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Kimai\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Kimai\\KimaiServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
