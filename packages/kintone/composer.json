{
    "name": "opencompanyapp/integration-kintone",
    "description": "Kintone integration for Laravel — manage records, apps, spaces, and users.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "kintone", "productivity", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-kintone": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Kintone\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Kintone\\KintoneServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
