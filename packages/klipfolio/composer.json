{
    "name": "opencompanyapp/integration-klipfolio",
    "description": "Klipfolio integration for Laravel — list and view dashboards, metrics, and data sources.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "klipfolio", "analytics", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-klipfolio": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Klipfolio\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Klipfolio\\KlipfolioServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
