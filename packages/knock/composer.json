{
    "name": "opencompanyapp/integration-knock",
    "description": "Knock notification engine integration for Laravel — manage workflows, messages, and recipients.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "knock", "notifications", "communication", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-knock": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Knock\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Knock\\KnockServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
