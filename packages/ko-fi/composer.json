{
    "name": "opencompanyapp/integration-ko-fi",
    "description": "Ko-fi integration for Laravel — manage supporters, transactions, commissions, and shop items.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "ko-fi", "productivity", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-ko-fi": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\KoFi\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\KoFi\\KoFiServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
