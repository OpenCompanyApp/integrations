{
    "name": "opencompanyapp/integration-lambda-labs",
    "description": "Lambda Labs GPU cloud integration for Laravel — manage GPU instances, SSH keys, instance types, and images.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "lambda-labs", "gpu", "cloud", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-lambda-labs": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\LambdaLabs\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\LambdaLabs\\LambdaLabsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
