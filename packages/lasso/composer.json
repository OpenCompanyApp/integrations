{
    "name": "opencompanyapp/integration-lasso",
    "description": "Lasso CRM integration for Laravel — manage contacts, deals, inventory, and user data for real estate.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "lasso", "crm", "real-estate", "sales", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-lasso": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Lasso\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Lasso\\LassoServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
