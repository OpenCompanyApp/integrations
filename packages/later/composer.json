{
    "name": "opencompanyapp/integration-later",
    "description": "Later integration for Laravel — manage social media scheduling, profiles, posts, and media.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "later", "social-media", "marketing", "scheduling", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-later": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Later\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Later\\LaterServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
