{
    "name": "opencompanyapp/integration-launchdarkly",
    "description": "LaunchDarkly feature flags integration for Laravel — list and toggle flags, manage projects and environments.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "launchdarkly", "feature-flags", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-launchdarkly": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\LaunchDarkly\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\LaunchDarkly\\LaunchDarklyServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
