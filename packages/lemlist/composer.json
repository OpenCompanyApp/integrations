{
    "name": "opencompanyapp/integration-lemlist",
    "description": "Lemlist integration for Laravel — manage campaigns, leads, teams, and sub-accounts.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "lemlist", "outreach", "email", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-lemlist": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Lemlist\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Lemlist\\LemlistServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
