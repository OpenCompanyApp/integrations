{
    "name": "opencompanyapp/integration-lemon-squeezy",
    "description": "Lemon Squeezy integration for Laravel: manage stores, products, variants, orders, subscriptions, customers, discounts, licenses, checkouts, and webhooks.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "lemon-squeezy", "ecommerce", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-lemon-squeezy": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\LemonSqueezy\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\LemonSqueezy\\LemonSqueezyServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
