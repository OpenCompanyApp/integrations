{
    "name": "opencompanyapp/integration-line",
    "description": "LINE Messaging API integration for Laravel agents: messages, webhooks, profiles, groups, quotas, rich menus, and account linking.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "line", "messaging", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-line": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Line\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Line\\LineServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
