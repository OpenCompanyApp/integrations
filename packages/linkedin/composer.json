{
    "name": "opencompanyapp/integration-linkedin",
    "description": "LinkedIn integration for Laravel — manage profiles, connections, organizations, and posts.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "linkedin", "social", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-linkedin": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\LinkedIn\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\LinkedIn\\LinkedInServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
