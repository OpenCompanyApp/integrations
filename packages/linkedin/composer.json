{
    "name": "opencompanyapp/integration-linkedin",
    "description": "LinkedIn integration for OpenCompany – posts, organizations, and ad accounts.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "opencompanyapp/integration-core": "*"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Linkedin\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Linkedin\\LinkedinServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
