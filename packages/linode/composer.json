{
    "name": "opencompanyapp/integration-linode",
    "description": "Linode/Akamai integration for Laravel — manage instances, volumes, domains, and stackscripts.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "linode", "akamai", "cloud", "instances", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-linode": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Linode\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Linode\\LinodeServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
