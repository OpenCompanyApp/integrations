{
    "name": "opencompanyapp/integration-litmos",
    "description": "Litmos LMS integration for Laravel — manage users, courses, and teams via the Litmos API.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "litmos", "education", "lms", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-litmos": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Litmos\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Litmos\\LitmosServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
