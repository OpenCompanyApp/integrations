{
    "name": "opencompanyapp/integration-lob",
    "description": "Lob print & mail integration for Laravel — send letters and postcards, manage addresses.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "lob", "direct-mail", "print", "letters", "postcards", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-lob": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Lob\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Lob\\LobServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
