{
    "name": "opencompanyapp/integration-lokalise",
    "description": "Lokalise localization platform integration for Laravel — manage projects, keys, translations, and contributors.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "lokalise", "localization", "translations", "productivity", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-lokalise": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Lokalise\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Lokalise\\LokaliseServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
