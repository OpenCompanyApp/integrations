{
    "name": "opencompanyapp/integration-loom",
    "description": "Loom video platform integration for Laravel — manage videos, workspaces, and user profiles.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "loom", "video", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-loom": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Loom\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Loom\\LoomServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
