{
    "name": "opencompanyapp/integration-loops",
    "description": "Loops integration for Laravel - contacts, events, transactional email, lists, properties, suppression, and config APIs.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "loops", "email", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-loops": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Loops\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Loops\\LoopsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
