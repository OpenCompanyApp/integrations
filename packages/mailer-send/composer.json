{
    "name": "opencompanyapp/integration-mailer-send",
    "description": "MailerSend integration for Laravel: transactional email, analytics, domains, templates, recipients, suppressions, webhooks, inbound routing, and SMTP users.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "mailer-send", "email", "marketing", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-mailer-send": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\MailerSend\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\MailerSend\\MailerSendServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
