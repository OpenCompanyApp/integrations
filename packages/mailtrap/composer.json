{
    "name": "opencompanyapp/integration-mailtrap",
    "description": "Mailtrap integration for Laravel — manage inboxes, messages, test emails, and suppressions.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "mailtrap", "email", "testing", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-mailtrap": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Mailtrap\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Mailtrap\\MailtrapServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
