{
    "name": "opencompanyapp/integration-manychat",
    "description": "ManyChat integration for Laravel — manage flows, tags, send messages, and get user info.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "manychat", "marketing", "chatbot", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-manychat": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\ManyChat\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\ManyChat\\ManyChatServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
