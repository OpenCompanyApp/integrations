{
    "name": "opencompanyapp/integration-mastodon",
    "description": "Mastodon integration for Laravel — list statuses, create posts, manage accounts.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "mastodon", "social", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-mastodon": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Mastodon\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Mastodon\\MastodonServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
