{
    "name": "opencompanyapp/integration-matrix",
    "description": "Matrix integration for Laravel — list rooms, send messages, manage members and profiles.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "matrix", "communication", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-matrix": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Matrix\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Matrix\\MatrixServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
