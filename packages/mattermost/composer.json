{
    "name": "opencompanyapp/integration-mattermost",
    "description": "Mattermost integration for Laravel — list channels, posts, teams, create messages, and manage workspace communication.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "mattermost", "communication", "messaging", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-mattermost": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Mattermost\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Mattermost\\MattermostServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
