{
    "name": "opencompanyapp/integration-meilisearch",
    "description": "Meilisearch integration for Laravel agents with official HTTP API coverage.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "meilisearch", "search", "data", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "autoload": {
