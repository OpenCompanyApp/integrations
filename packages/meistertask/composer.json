{
    "name": "opencompanyapp/integration-meistertask",
    "description": "MeisterTask integration for Laravel — manage projects and tasks via the MeisterTask API.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "meistertask", "productivity", "tasks", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-meistertask": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\MeisterTask\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\MeisterTask\\MeisterTaskServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
