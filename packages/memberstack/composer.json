{
    "name": "opencompanyapp/integration-memberstack",
    "description": "Memberstack integration for Laravel — manage members, plans, and authentication.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "memberstack", "authentication", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-memberstack": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Memberstack\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Memberstack\\MemberstackServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
