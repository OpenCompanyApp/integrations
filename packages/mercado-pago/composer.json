{
    "name": "opencompanyapp/integration-mercado-pago",
    "description": "Mercado Pago integration for Laravel — manage payments, customers, and checkout preferences.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "mercado-pago", "payments", "finance", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-mercado-pago": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\MercadoPago\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\MercadoPago\\MercadoPagoServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
