{
    "name": "opencompanyapp/integration-messagebird",
    "description": "MessageBird REST API integration for Laravel agents: SMS, voice messages, contacts, groups, lookup, HLR, verify, balance, and numbers.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "messagebird", "sms", "messaging", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-messagebird": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\MessageBird\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\MessageBird\\MessageBirdServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
