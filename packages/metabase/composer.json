{
    "name": "opencompanyapp/integration-metabase",
    "description": "Metabase BI integration for Laravel — query dashboards, cards, and databases.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "metabase", "analytics", "bi", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-metabase": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Metabase\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Metabase\\MetabaseServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
