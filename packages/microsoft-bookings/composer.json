{
    "name": "opencompanyapp/integration-microsoft-bookings",
    "description": "Microsoft Bookings integration through Microsoft Graph for OpenCompany agents.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "opencompanyapp/integration-core": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\MicrosoftBookings\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\MicrosoftBookings\\MicrosoftBookingsServiceProvider"
            ]
        }
    },
    "keywords": [
        "tools",
        "microsoft",
        "bookings",
        "appointments",
        "calendar",
        "graph",
        "opencompany"
    ]
}
