{
    "name": "opencompanyapp/integration-microsoft-excel",
    "description": "Microsoft Excel workbook integration through Microsoft Graph for OpenCompany agents.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "opencompanyapp/integration-core": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\MicrosoftExcel\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\MicrosoftExcel\\MicrosoftExcelServiceProvider"
            ]
        }
    },
    "keywords": [
        "tools",
        "microsoft",
        "excel",
        "workbook",
        "spreadsheet",
        "graph",
        "opencompany"
    ]
}
