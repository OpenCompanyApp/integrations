{
    "name": "opencompanyapp/integration-microsoft-onenote",
    "description": "Microsoft OneNote integration through Microsoft Graph for OpenCompany agents.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "opencompanyapp/integration-core": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\MicrosoftOneNote\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\MicrosoftOneNote\\MicrosoftOneNoteServiceProvider"
            ]
        }
    },
    "keywords": [
        "tools",
        "microsoft",
        "onenote",
        "notes",
        "notebooks",
        "pages",
        "graph",
        "opencompany"
    ]
}
