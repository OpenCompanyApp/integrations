{
    "name": "opencompanyapp/integration-microsoft-planner",
    "description": "Microsoft Planner integration through Microsoft Graph for OpenCompany agents.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "opencompanyapp/integration-core": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\MicrosoftPlanner\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\MicrosoftPlanner\\MicrosoftPlannerServiceProvider"
            ]
        }
    },
    "keywords": [
        "tools",
        "microsoft",
        "planner",
        "tasks",
        "kanban",
        "graph",
        "opencompany"
    ]
}
