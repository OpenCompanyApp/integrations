{
    "name": "opencompanyapp/integration-microsoft-power-bi",
    "description": "Microsoft Power BI integration for Laravel — list workspaces, datasets, reports, and get current user profile.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "power-bi", "microsoft", "analytics", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-microsoft-power-bi": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\PowerBi\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\PowerBi\\PowerBiServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
