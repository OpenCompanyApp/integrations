{
    "name": "opencompanyapp/integration-microsoft-powerbi",
    "description": "Legacy Microsoft Power BI package. Use opencompanyapp/integration-microsoft-power-bi.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "powerbi", "microsoft", "analytics", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "abandoned": "opencompanyapp/integration-microsoft-power-bi",
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\MicrosoftPowerBI\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\MicrosoftPowerBI\\PowerBIServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
