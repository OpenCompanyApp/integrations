{
    "name": "opencompanyapp/integration-microsoft-reports",
    "description": "Microsoft Graph reports integration for OpenCompany agents.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "opencompanyapp/integration-core": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\MicrosoftReports\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\MicrosoftReports\\MicrosoftReportsServiceProvider"
            ]
        }
    },
    "keywords": [
        "tools",
        "microsoft",
        "reports",
        "usage",
        "activity",
        "teams",
        "sharepoint",
        "graph",
        "opencompany"
    ]
}
