{
    "name": "opencompanyapp/integration-microsoft-teams",
    "description": "Microsoft Teams integration for Laravel — list teams, channels, messages, send messages, and manage chats via the Graph API.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "microsoft-teams", "teams", "chat", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-microsoft-teams": "self.version",
        "opencompanyapp/integration-teams": "self.version",
        "opencompanyapp/ai-tool-teams": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\MicrosoftTeams\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\MicrosoftTeams\\MicrosoftTeamsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
