{
    "name": "opencompanyapp/integration-missive",
    "description": "Missive REST API integration for Laravel — conversations, drafts, tasks, contacts, teams, responses, analytics, and webhooks.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "missive", "email", "chat", "conversations", "tasks", "contacts", "analytics", "webhooks", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-missive": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Missive\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Missive\\MissiveServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
