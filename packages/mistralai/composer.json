{
    "name": "opencompanyapp/integration-mistralai",
    "description": "MistralAI integration for Laravel — chat completions, embeddings, model management, fine-tuning, and agent management.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "mistralai", "ai", "llm", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-mistralai": "self.version"
    },
    "abandoned": "opencompanyapp/integration-mistral",
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\MistralAI\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\MistralAI\\MistralAIServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
