{
    "name": "opencompanyapp/integration-mollie",
    "description": "Mollie payments integration for Laravel — manage payments, customers, subscriptions and invoices.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "mollie", "payments", "subscriptions", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-mollie": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Mollie\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Mollie\\MollieServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
