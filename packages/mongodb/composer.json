{
    "name": "opencompanyapp/integration-mongodb",
    "description": "MongoDB Atlas Data API integration for Laravel: find, insert, update, delete, and aggregate documents.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "mongodb", "atlas", "data-api", "nosql", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-mongodb": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\MongoDB\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\MongoDB\\MongoDBServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
