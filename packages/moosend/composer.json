{
    "name": "opencompanyapp/integration-moosend",
    "description": "Moosend integration for Laravel — manage mailing lists, subscribers, and campaigns.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "moosend", "email-marketing", "marketing", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-moosend": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Moosend\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Moosend\\MoosendServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
