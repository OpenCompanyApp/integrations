{
    "name": "opencompanyapp/integration-motion",
    "description": "Motion API integration for Laravel — manage tasks, projects, schedules, and users.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "motion", "productivity", "tasks", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-motion": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Motion\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Motion\\MotionServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
