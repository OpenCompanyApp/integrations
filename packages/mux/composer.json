{
    "name": "opencompanyapp/integration-mux",
    "description": "Mux video integration for Laravel — manage assets, live streams, and realtime data.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "mux", "video", "media", "live-streaming", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-mux": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Mux\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Mux\\MuxServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
