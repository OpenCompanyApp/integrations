{
    "name": "opencompanyapp/integration-mysql",
    "description": "MySQL integration for Laravel — query databases, manage tables, and perform CRUD operations via HTTP REST bridge.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "mysql", "database", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-mysql": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\MySQL\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\MySQL\\MySQLServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
