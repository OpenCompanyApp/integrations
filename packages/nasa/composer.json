{
    "name": "opencompanyapp/integration-nasa",
    "description": "NASA API integration for Laravel: APOD, Mars rover photos, asteroid tracking, DONKI, EPIC, Image Library, and EONET.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "nasa", "science", "space", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-nasa": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Nasa\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Nasa\\NasaServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
