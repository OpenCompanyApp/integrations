{
    "name": "opencompanyapp/integration-neon",
    "description": "Neon serverless Postgres integration for Laravel — manage projects, branches, and databases.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "neon", "postgres", "database", "serverless", "branches", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-neon": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Neon\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Neon\\NeonServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
