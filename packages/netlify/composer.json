{
    "name": "opencompanyapp/integration-netlify",
    "description": "Netlify integration for Laravel — manage sites, deploys, forms, and DNS zones.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "netlify", "deployment", "productivity", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-netlify": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Netlify\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Netlify\\NetlifyServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
