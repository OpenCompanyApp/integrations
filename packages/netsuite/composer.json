{
    "name": "opencompanyapp/integration-netsuite",
    "description": "NetSuite ERP integration for Laravel — manage customers, invoices, sales orders, and items.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "netsuite", "erp", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-netsuite": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\NetSuite\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\NetSuite\\NetSuiteServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
