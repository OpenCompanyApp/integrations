{
    "name": "opencompanyapp/integration-newrelic",
    "description": "New Relic APM integration for Laravel — monitor applications, deployments, alerts, and dashboards.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "newrelic", "analytics", "apm", "monitoring", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-newrelic": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\NewRelic\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\NewRelic\\NewRelicServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
