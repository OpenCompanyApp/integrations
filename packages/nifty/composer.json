{
    "name": "opencompanyapp/integration-nifty",
    "description": "Nifty project management integration for Laravel — list projects, manage tasks, and get user info.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "nifty", "productivity", "project-management", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-nifty": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Nifty\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Nifty\\NiftyServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
