{
    "name": "opencompanyapp/integration-novu",
    "description": "Novu notification platform integration for Laravel — manage notifications, subscribers, and trigger events.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "novu", "notifications", "communication", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-novu": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Novu\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Novu\\NovuServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
