{
    "name": "opencompanyapp/integration-nvd",
    "description": "National Vulnerability Database integration for Laravel AI agents - CVEs, CVE change history, CPE names, CPE match criteria, and NVD data sources.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "opencompanyapp/integration-core": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Nvd\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Nvd\\NvdServiceProvider"
            ]
        }
    },
    "keywords": [
        "tools",
        "nvd",
        "nist",
        "cve",
        "cpe",
        "vulnerability",
        "security",
        "opencompany"
    ]
}
