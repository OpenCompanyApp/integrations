{
    "name": "opencompanyapp/integration-one-signal",
    "description": "OneSignal integration for Laravel — send push notifications, manage devices and apps.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "onesignal", "push-notifications", "communication", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-one-signal": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\OneSignal\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\OneSignal\\OneSignalServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
