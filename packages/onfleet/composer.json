{
    "name": "opencompanyapp/integration-onfleet",
    "description": "Onfleet delivery management integration for Laravel — manage tasks, workers, teams, and recipients.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "onfleet", "delivery", "logistics", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-onfleet": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Onfleet\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Onfleet\\OnfleetServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
