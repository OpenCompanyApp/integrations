{
    "name": "opencompanyapp/integration-openfda",
    "description": "openFDA integration for Laravel AI agents - FDA drug, device, food, animal, cosmetic, tobacco, and other public datasets.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "opencompanyapp/integration-core": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\OpenFda\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\OpenFda\\OpenFdaServiceProvider"
            ]
        }
    },
    "keywords": [
        "tools",
        "openfda",
        "fda",
        "drug",
        "device",
        "food",
        "recall",
        "opencompany"
    ]
}
