{
    "name": "opencompanyapp/integration-openfigi",
    "description": "OpenFIGI integration for Laravel AI agents - map identifiers to FIGIs, search/filter instruments, list enum values, and fetch the OpenAPI schema.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "opencompanyapp/integration-core": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\OpenFigi\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\OpenFigi\\OpenFigiServiceProvider"
            ]
        }
    },
    "keywords": [
        "tools",
        "openfigi",
        "figi",
        "isin",
        "cusip",
        "sedol",
        "securities",
        "identifiers",
        "opencompany"
    ]
}
