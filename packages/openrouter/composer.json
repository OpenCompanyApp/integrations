{
    "name": "opencompanyapp/integration-openrouter",
    "description": "OpenRouter AI gateway integration for Laravel — list models, create completions, manage generations, keys, and usage.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "openrouter", "ai", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-openrouter": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Openrouter\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Openrouter\\OpenrouterServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
