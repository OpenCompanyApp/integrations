{
    "name": "opencompanyapp/integration-openssf-scorecard",
    "description": "OpenSSF Scorecard integration for Laravel AI agents - published repository score results, individual checks, badge SVGs, and viewer URLs.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "opencompanyapp/integration-core": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\OpenSsfScorecard\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\OpenSsfScorecard\\OpenSsfScorecardServiceProvider"
            ]
        }
    },
    "keywords": [
        "tools",
        "openssf",
        "scorecard",
        "security",
        "supply-chain",
        "opencompany"
    ]
}
