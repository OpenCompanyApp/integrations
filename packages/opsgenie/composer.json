{
    "name": "opencompanyapp/integration-opsgenie",
    "description": "Opsgenie integration for Laravel — manage alerts, incidents, and teams.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "opsgenie", "incident-management", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-opsgenie": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Opsgenie\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Opsgenie\\OpsgenieServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
