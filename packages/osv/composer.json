{
    "name": "opencompanyapp/integration-osv",
    "description": "OSV.dev integration for Laravel AI agents - query open source vulnerabilities by package, commit, ID, batch queries, import findings, and experimental version determination.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "opencompanyapp/integration-core": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Osv\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Osv\\OsvServiceProvider"
            ]
        }
    },
    "keywords": [
        "tools",
        "osv",
        "osv.dev",
        "open-source-vulnerabilities",
        "vulnerability",
        "security",
        "opencompany"
    ]
}
