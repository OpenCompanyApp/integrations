{
    "name": "opencompanyapp/integration-ovh",
    "description": "OVHcloud integration for Laravel — manage dedicated servers, domains, VPS, IP addresses, and public cloud projects.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "ovh", "ovhcloud", "cloud", "servers", "domains", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-ovh": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Ovh\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Ovh\\OvhServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
