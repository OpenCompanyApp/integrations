{
    "name": "opencompanyapp/integration-paddle",
    "description": "Paddle integration for Laravel — manage transactions, customers, and products.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "paddle", "payments", "finance", "subscriptions", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-paddle": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Paddle\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Paddle\\PaddleServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
