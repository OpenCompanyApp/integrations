{
    "name": "opencompanyapp/integration-pandadoc",
    "description": "PandaDoc integration for Laravel — manage documents, templates, and e-signatures.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "pandadoc", "documents", "esignature", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-pandadoc": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\PandaDoc\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\PandaDoc\\PandaDocServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
