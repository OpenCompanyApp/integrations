{
    "name": "opencompanyapp/integration-paperspace",
    "description": "Paperspace integration for Laravel — manage machines, notebooks, datasets, projects, and SSH keys.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "paperspace", "gpu", "cloud", "ml", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-paperspace": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Paperspace\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Paperspace\\PaperspaceServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
