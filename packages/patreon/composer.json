{
    "name": "opencompanyapp/integration-patreon",
    "description": "Patreon integration for Laravel — manage campaigns, members, posts, and creator profile.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "patreon", "creator", "productivity", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-patreon": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Patreon\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Patreon\\PatreonServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
