{
    "name": "opencompanyapp/integration-paypal",
    "description": "PayPal integration for Laravel — manage orders, payments, and invoices via the PayPal API.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "paypal", "payments", "orders", "invoices", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-paypal": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\PayPal\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\PayPal\\PayPalServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
