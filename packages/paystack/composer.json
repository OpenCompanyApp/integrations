{
    "name": "opencompanyapp/integration-paystack",
    "description": "Paystack integration for Laravel — manage transactions, customers, and plans.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "paystack", "payments", "finance", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-paystack": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Paystack\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Paystack\\PaystackServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
