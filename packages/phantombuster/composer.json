{
    "name": "opencompanyapp/integration-phantombuster",
    "description": "Phantombuster integration for Laravel: agents, containers, scripts, organization metadata, and outputs.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "phantombuster", "automation", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-phantombuster": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Phantombuster\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Phantombuster\\PhantombusterServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
