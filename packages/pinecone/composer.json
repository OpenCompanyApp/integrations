{
    "name": "opencompanyapp/integration-pinecone",
    "description": "Pinecone vector database integration for Laravel — manage indexes, upsert vectors, and query embeddings.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "pinecone", "database", "vectors", "embeddings", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-pinecone": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Pinecone\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Pinecone\\PineconeServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
