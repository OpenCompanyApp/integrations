{
    "name": "opencompanyapp/integration-pingdom",
    "description": "Pingdom uptime monitoring integration for Laravel — list checks, get check details, create checks, view results, manage alerts.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "pingdom", "analytics", "monitoring", "uptime", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-pingdom": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Pingdom\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Pingdom\\PingdomServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
