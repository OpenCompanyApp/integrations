{
    "name": "opencompanyapp/integration-pipedream",
    "description": "Pipedream integration for Laravel — manage workflows, components, triggers and connected accounts.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "pipedream", "automation", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-pipedream": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Pipedream\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Pipedream\\PipedreamServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
