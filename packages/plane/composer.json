{
    "name": "opencompanyapp/integration-plane",
    "description": "Plane.so integration for Laravel — manage projects, issues, cycles, modules, and team members.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "plane", "project-management", "issues", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-plane": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Plane\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Plane\\PlaneServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
