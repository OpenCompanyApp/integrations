{
    "name": "opencompanyapp/integration-planetscale",
    "description": "PlanetScale serverless MySQL integration for Laravel — manage databases, branches, and organizations.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "planetscale", "data", "mysql", "serverless", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-planetscale": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\PlanetScale\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\PlanetScale\\PlanetScaleServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
