{
    "name": "opencompanyapp/integration-plivo",
    "description": "Plivo integration for Laravel — send SMS, manage calls, phone numbers, and applications.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "plivo", "sms", "voice", "communication", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-plivo": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Plivo\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Plivo\\PlivoServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
