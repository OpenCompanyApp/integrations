{
    "name": "opencompanyapp/integration-podia",
    "description": "Podia integration for Laravel — manage online courses, digital downloads, customers, and sales.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "podia", "productivity", "courses", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-podia": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Podia\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Podia\\PodiaServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
