{
    "name": "opencompanyapp/integration-posthog",
    "description": "PostHog integration for Laravel with generated coverage from the official PostHog OpenAPI schema.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": [
        "tools",
        "posthog",
        "analytics",
        "feature-flags",
        "opencompany"
    ],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-posthog": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\PostHog\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\PostHog\\PostHogServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
