{
    "name": "opencompanyapp/integration-postmark",
    "description": "Postmark email integration for Laravel — send emails, manage templates, and track delivery.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "postmark", "email", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-postmark": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Postmark\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Postmark\\PostmarkServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
