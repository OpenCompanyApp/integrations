{
    "name": "opencompanyapp/integration-prismic",
    "description": "Prismic headless CMS integration for Laravel — list and search documents, types, tags, refs, and languages.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "prismic", "cms", "headless", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-prismic": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Prismic\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Prismic\\PrismicServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
