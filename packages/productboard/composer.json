{
    "name": "opencompanyapp/integration-productboard",
    "description": "Productboard integration for Laravel — manage features, notes, products, and companies.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "productboard", "product-management", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-productboard": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Productboard\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Productboard\\ProductboardServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
