{
    "name": "opencompanyapp/integration-pushbullet",
    "description": "Pushbullet integration for Laravel — send pushes, manage devices, and retrieve user info.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "pushbullet", "notifications", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-pushbullet": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Pushbullet\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Pushbullet\\PushbulletServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
