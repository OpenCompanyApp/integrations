{
    "name": "opencompanyapp/integration-pushover",
    "description": "Pushover integration for Laravel — messages, sounds, validation, receipts, subscriptions, groups, teams, glances, limits, and license credits.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "pushover", "notifications", "push", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-pushover": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Pushover\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Pushover\\PushoverServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
