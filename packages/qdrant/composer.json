{
    "name": "opencompanyapp/integration-qdrant",
    "description": "Qdrant vector database integration for Laravel — search, upsert points, manage collections.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "qdrant", "database", "vectors", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-qdrant": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Qdrant\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Qdrant\\QdrantServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
