{
    "name": "opencompanyapp/integration-qualifying",
    "description": "Qualifying CRM integration for Laravel — manage accounts, contacts, and deals.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "qualifying", "sales", "crm", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-qualifying": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Qualifying\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Qualifying\\QualifyingServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
