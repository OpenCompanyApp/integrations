{
    "name": "opencompanyapp/integration-quickbase",
    "description": "QuickBase low-code database integration for Laravel — list tables, query records, create records, and more.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "quickbase", "database", "low-code", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-quickbase": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\QuickBase\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\QuickBase\\QuickBaseServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
