{
    "name": "opencompanyapp/integration-quickbooks",
    "description": "QuickBooks Online integration for Laravel — invoices, customers, and accounts.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "quickbooks", "accounting", "finance", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-quickbooks": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\QuickBooks\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\QuickBooks\\QuickBooksServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
