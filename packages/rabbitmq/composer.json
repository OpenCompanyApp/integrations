{
    "name": "opencompanyapp/integration-rabbitmq",
    "description": "RabbitMQ Management HTTP API integration for Laravel agents: monitor and manage queues, exchanges, bindings, vhosts, users, permissions, nodes, and definitions.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "rabbitmq", "messaging", "queue", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-rabbitmq": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\RabbitMQ\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\RabbitMQ\\RabbitMQServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
