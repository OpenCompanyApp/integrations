{
    "name": "opencompanyapp/integration-radar",
    "description": "Radar integration for Laravel — geofencing, location tracking, and event management.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "radar", "geofencing", "location", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-radar": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Radar\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Radar\\RadarServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
