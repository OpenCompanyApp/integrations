{
    "name": "opencompanyapp/integration-railway",
    "description": "Railway cloud platform integration for Laravel — manage projects, services, and deployments.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "railway", "cloud", "hosting", "deployments", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-railway": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Railway\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Railway\\RailwayServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
