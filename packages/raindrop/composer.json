{
    "name": "opencompanyapp/integration-raindrop",
    "description": "Raindrop.io bookmark manager integration for Laravel — manage bookmarks and collections.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "raindrop", "bookmarks", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-raindrop": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Raindrop\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Raindrop\\RaindropServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
