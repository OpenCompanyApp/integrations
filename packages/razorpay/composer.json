{
    "name": "opencompanyapp/integration-razorpay",
    "description": "Razorpay integration for Laravel — list payments, orders, refunds, and customers.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "razorpay", "payments", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-razorpay": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Razorpay\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Razorpay\\RazorpayServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
