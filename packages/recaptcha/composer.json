{
    "name": "opencompanyapp/integration-recaptcha",
    "description": "Google reCAPTCHA Enterprise integration for Laravel — verify tokens, manage keys, assessments, and annotations.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "recaptcha", "google", "security", "captcha", "verification", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-recaptcha": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Recaptcha\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Recaptcha\\RecaptchaServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
