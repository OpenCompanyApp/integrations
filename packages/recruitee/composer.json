{
    "name": "opencompanyapp/integration-recruitee",
    "description": "Recruitee ATS integration for Laravel with candidate, offer, location, attachment, and Core API coverage.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "recruitee", "ats", "recruiting", "applicant-tracking", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Recruitee\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Recruitee\\RecruiteeServiceProvider"
