{
    "name": "opencompanyapp/integration-recurly",
    "description": "Recurly subscription billing integration for Laravel — manage accounts, subscriptions, and plans.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "recurly", "billing", "subscriptions", "finance", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-recurly": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Recurly\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Recurly\\RecurlyServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
