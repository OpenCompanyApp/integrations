{
    "name": "opencompanyapp/integration-render2",
    "description": "Render integration for Laravel — manage services, deploys, and jobs on the Render cloud platform.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "render", "cloud", "deploy", "services", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-render2": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Render2\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Render2\\RenderServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
