{
    "name": "opencompanyapp/integration-replicate",
    "description": "Replicate integration for Laravel — AI model hosting, predictions, and model management.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "replicate", "ai", "predictions", "models", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-replicate": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Replicate\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Replicate\\ReplicateServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
