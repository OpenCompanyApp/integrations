{
    "name": "opencompanyapp/integration-retell-ai",
    "description": "Retell AI integration for Laravel — create and manage AI phone calls and agents.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "retell-ai", "voice", "phone", "ai-agents", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-retell-ai": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\RetellAI\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\RetellAI\\RetellAIServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
