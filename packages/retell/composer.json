{
    "name": "opencompanyapp/integration-retell",
    "description": "Legacy compatibility wrapper for opencompanyapp/integration-retell-ai.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "retell", "ai", "voice", "calls", "agents", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-retell": "self.version"
    },
    "abandoned": "opencompanyapp/integration-retell-ai",
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Retell\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Retell\\RetellServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
