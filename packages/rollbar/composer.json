{
    "name": "opencompanyapp/integration-rollbar",
    "description": "Rollbar error monitoring integration for Laravel — list projects, items, deploys, and teams.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "rollbar", "error-monitoring", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-rollbar": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Rollbar\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Rollbar\\RollbarServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
