{
    "name": "opencompanyapp/integration-runpod",
    "description": "RunPod integration for Laravel — manage GPU pods, endpoints, and serverless functions.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "runpod", "productivity", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-runpod": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Runpod\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Runpod\\RunpodServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
