{
    "name": "opencompanyapp/integration-salesloft",
    "description": "Salesloft integration for Laravel — manage call sequences, rules, and user data.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "salesloft", "sales", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-salesloft": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Salesloft\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Salesloft\\SalesloftServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
