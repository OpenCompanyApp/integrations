{
    "name": "opencompanyapp/integration-samsara",
    "description": "Samsara integration for Laravel AI agents - fleet telematics, routes, assets, sensors, documents, maintenance, users, and raw REST API tools.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "samsara", "fleet", "iot", "vehicles", "drivers", "sensors", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Samsara\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Samsara\\SamsaraServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
