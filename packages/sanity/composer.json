{
    "name": "opencompanyapp/integration-sanity",
    "description": "Sanity headless CMS integration for Laravel — query documents, manage content, list projects.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "sanity", "cms", "headless", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-sanity": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Sanity\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Sanity\\SanityServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
