{
    "name": "opencompanyapp/integration-scaleway",
    "description": "Scaleway integration for Laravel — manage servers, volumes, snapshots, security groups, and IPs.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "scaleway", "cloud", "servers", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-scaleway": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Scaleway\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Scaleway\\ScalewayServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
