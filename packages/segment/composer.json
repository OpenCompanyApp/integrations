{
    "name": "opencompanyapp/integration-segment",
    "description": "Segment integration for Laravel — identify users, track events, page views, group management, and workspace/source lookups.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "segment", "analytics", "cdp", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-segment": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Segment\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Segment\\SegmentServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
