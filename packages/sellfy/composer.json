{
    "name": "opencompanyapp/integration-sellfy",
    "description": "Sellfy integration for Laravel — list products, create products, manage orders, and customers.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "sellfy", "ecommerce", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-sellfy": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Sellfy\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Sellfy\\SellfyServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
