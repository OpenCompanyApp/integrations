{
    "name": "opencompanyapp/integration-semaphore-ci",
    "description": "Semaphore CI API v1alpha integration for Laravel AI agents - workflows, pipelines, jobs, agents, deployment targets, artifacts, and raw helper calls.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\SemaphoreCi\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\SemaphoreCi\\SemaphoreCiServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "opencompanyapp/integration-core": "*"
    }
}
