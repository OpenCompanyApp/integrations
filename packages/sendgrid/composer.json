{
    "name": "opencompanyapp/integration-sendgrid",
    "description": "SendGrid integration for Laravel — send emails, manage templates and contacts.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "sendgrid", "email", "communication", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-sendgrid": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Sendgrid\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Sendgrid\\SendgridServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
