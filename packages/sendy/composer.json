{
    "name": "opencompanyapp/integration-sendy",
    "description": "Sendy newsletter integration for Laravel — manage subscribers, campaigns, and brands.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "sendy", "newsletter", "email", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-sendy": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Sendy\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Sendy\\SendyServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
