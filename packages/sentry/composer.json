{
    "name": "opencompanyapp/integration-sentry",
    "description": "Sentry integration for Laravel — list projects, issues, releases, and manage errors.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "sentry", "monitoring", "errors", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-sentry": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Sentry\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Sentry\\SentryServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
