{
    "name": "opencompanyapp/integration-service-m8",
    "description": "ServiceM8 integration for Laravel — manage jobs, clients, activities, and users.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "servicem8", "field-service", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-service-m8": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\ServiceM8\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\ServiceM8\\ServiceM8ServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
