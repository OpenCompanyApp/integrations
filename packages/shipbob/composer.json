{
    "name": "opencompanyapp/integration-shipbob",
    "description": "ShipBob fulfillment integration for Laravel — manage orders, products, and shipments.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "shipbob", "ecommerce", "fulfillment", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-shipbob": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\ShipBob\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\ShipBob\\ShipBobServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
