{
    "name": "opencompanyapp/integration-shopify",
    "description": "Shopify integration for Laravel — manage products, orders, and customers.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "shopify", "ecommerce", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-shopify": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Shopify\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Shopify\\ShopifyServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
