{
    "name": "opencompanyapp/integration-signnow",
    "description": "SignNow integration for Laravel: documents, templates, invites, downloads, and API helpers.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "signnow", "esignature", "documents", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-signnow": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\SignNow\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\SignNow\\SignNowServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
