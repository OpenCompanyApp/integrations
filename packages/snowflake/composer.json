{
    "name": "opencompanyapp/integration-snowflake",
    "description": "Snowflake integration for Laravel — execute SQL queries, manage databases, schemas, tables, and warehouses.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "snowflake", "database", "data-warehouse", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-snowflake": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Snowflake\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Snowflake\\SnowflakeServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
