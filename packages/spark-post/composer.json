{
    "name": "opencompanyapp/integration-spark-post",
    "description": "SparkPost email delivery integration for Laravel — manage sending domains, templates, transmissions, and webhooks.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "spark-post", "email", "marketing", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-spark-post": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\SparkPost\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\SparkPost\\SparkPostServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
