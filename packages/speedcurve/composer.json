{
    "name": "opencompanyapp/integration-speedcurve",
    "description": "SpeedCurve performance monitoring integration for Laravel — manage sites, tests, and deployments.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "speedcurve", "analytics", "performance", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-speedcurve": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Speedcurve\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Speedcurve\\SpeedcurveServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
