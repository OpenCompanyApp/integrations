{
    "name": "opencompanyapp/integration-split",
    "description": "Split feature flags integration for Laravel — manage splits, environments, and workspaces.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "split", "feature-flags", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-split": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Split\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Split\\SplitServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
