{
    "name": "opencompanyapp/integration-splitwise",
    "description": "Splitwise integration for Laravel — manage shared expenses, groups, and friends.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "splitwise", "expenses", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-splitwise": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Splitwise\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Splitwise\\SplitwiseServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
