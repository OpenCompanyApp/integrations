{
    "name": "opencompanyapp/integration-spotify",
    "description": "Spotify integration for Laravel — search tracks, manage playlists, browse artists and albums.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "spotify", "music", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-spotify": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Spotify\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Spotify\\SpotifyServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
