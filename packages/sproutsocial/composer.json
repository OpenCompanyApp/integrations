{
    "name": "opencompanyapp/integration-sproutsocial",
    "description": "Sprout Social integration for Laravel — manage social media profiles, posts, and messages.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "sproutsocial", "social-media", "marketing", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-sproutsocial": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\SproutSocial\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\SproutSocial\\SproutSocialServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
