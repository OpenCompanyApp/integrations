{
    "name": "opencompanyapp/integration-square",
    "description": "Square integration for OpenCompany — payments, customers, and orders.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "square", "payments", "orders", "sales", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Square\\": "src/"
        }
