{
    "name": "opencompanyapp/integration-storyblok",
    "description": "Storyblok headless CMS integration for Laravel — manage stories, components, and content.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "storyblok", "cms", "headless", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-storyblok": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Storyblok\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Storyblok\\StoryblokServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
