{
    "name": "opencompanyapp/integration-strapi",
    "description": "Strapi headless CMS integration for Laravel — manage content types, entries, and users.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "strapi", "cms", "headless", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-strapi": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Strapi\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Strapi\\StrapiServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
