{
    "name": "opencompanyapp/integration-strava",
    "description": "Strava fitness/activity integration for Laravel — list activities, view athlete profiles, manage clubs.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "strava", "fitness", "activities", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-strava": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Strava\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Strava\\StravaServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
