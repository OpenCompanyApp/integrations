{
    "name": "opencompanyapp/integration-surveymonkey",
    "description": "SurveyMonkey integration for Laravel — manage surveys, responses, and collectors.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "surveymonkey", "surveys", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-surveymonkey": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\SurveyMonkey\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\SurveyMonkey\\SurveyMonkeyServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
