{
    "name": "opencompanyapp/integration-svix",
    "description": "Svix webhook service integration for Laravel — manage applications, endpoints, and messages.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "svix", "webhooks", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-svix": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Svix\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Svix\\SvixServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
