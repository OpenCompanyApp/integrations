{
    "name": "opencompanyapp/integration-tableau",
    "description": "Tableau business intelligence integration for Laravel — list workbooks, views, projects, and user info.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "tableau", "analytics", "bi", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-tableau": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Tableau\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Tableau\\TableauServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
