{
    "name": "opencompanyapp/integration-taiga",
    "description": "Taiga project management integration for Laravel — list projects, manage user stories and issues.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "taiga", "project-management", "productivity", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-taiga": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Taiga\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Taiga\\TaigaServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
