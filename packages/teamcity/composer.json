{
    "name": "opencompanyapp/integration-teamcity",
    "description": "TeamCity integration for Laravel AI agents - projects, build configurations, builds, queue, agents, users, and REST helper calls.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\TeamCity\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\TeamCity\\TeamCityServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "opencompanyapp/integration-core": "*"
    }
}
