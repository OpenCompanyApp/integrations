{
    "name": "opencompanyapp/integration-teams",
    "description": "Microsoft Teams integration for OpenCompany — teams, channels, messages, and users.",
    "license": "MIT",
    "authors": [{"name": "OpenCompany", "homepage": "https://github.com/OpenCompanyApp"}],
    "keywords": ["tools", "teams", "microsoft-teams", "communication", "opencompany"],
    "require": {"php": "^8.2", "opencompanyapp/integration-core": "^2.0 || @dev"},
    "replace": {
        "opencompanyapp/ai-tool-teams": "self.version"
    },
    "abandoned": "opencompanyapp/integration-microsoft-teams",
    "autoload": {"psr-4": {"OpenCompany\\Integrations\\Teams\\": "src/"}},
    "extra": {"laravel": {"providers": ["OpenCompany\\Integrations\\Teams\\TeamsServiceProvider"]}},
    "minimum-stability": "stable",
    "prefer-stable": true
}
