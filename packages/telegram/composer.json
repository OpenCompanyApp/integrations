{
    "name": "opencompanyapp/integration-telegram",
    "description": "Telegram Bot API integration for Laravel — send messages, photos, manage chats, and get bot information.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "telegram", "communication", "messaging", "bot", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-telegram": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Telegram\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Telegram\\TelegramServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
