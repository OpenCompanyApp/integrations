{
    "name": "opencompanyapp/integration-telnyx",
    "description": "Telnyx voice and SMS integration for Laravel — manage phone numbers, send messages, and retrieve call records.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "telnyx", "communication", "voice", "sms", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-telnyx": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Telnyx\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Telnyx\\TelnyxServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
