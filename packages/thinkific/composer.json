{
    "name": "opencompanyapp/integration-thinkific",
    "description": "Thinkific online courses integration for Laravel — manage courses, enrollments, and users via the Thinkific API.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "thinkific", "education", "courses", "productivity", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-thinkific": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Thinkific\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Thinkific\\ThinkificServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
