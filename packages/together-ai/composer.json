{
    "name": "opencompanyapp/integration-together-ai",
    "description": "Together AI integration for Laravel — list models, create completions, manage fine-tunes, files, and account.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "together-ai", "ai", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-together-ai": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\TogetherAi\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\TogetherAi\\TogetherAiServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
