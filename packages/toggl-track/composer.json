{
    "name": "opencompanyapp/integration-toggl-track",
    "description": "Toggl Track integration for Laravel — manage time entries, projects, and workspaces.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "toggl", "toggl-track", "time-tracking", "productivity", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-toggl-track": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\TogglTrack\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\TogglTrack\\TogglTrackServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
