{
    "name": "opencompanyapp/integration-toggl",
    "description": "Toggl integration for Laravel — manage workspaces, projects, and time entries.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "toggl", "time-tracking", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-toggl": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Toggl\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Toggl\\TogglServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
