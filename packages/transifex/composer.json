{
    "name": "opencompanyapp/integration-transifex",
    "description": "Transifex translation platform integration for Laravel — manage projects, resources, translations, and languages.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "transifex", "translation", "localization", "productivity", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-transifex": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Transifex\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Transifex\\TransifexServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
