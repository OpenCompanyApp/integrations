{
    "name": "opencompanyapp/integration-trustmrr",
    "description": "TrustMRR startup revenue data integration for Laravel — browse startups, filter by revenue, MRR, growth, and asking price.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "trustmrr", "startups", "revenue", "mrr", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-trustmrr": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\TrustMrr\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\TrustMrr\\TrustMrrServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
