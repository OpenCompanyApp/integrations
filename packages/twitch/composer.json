{
    "name": "opencompanyapp/integration-twitch",
    "description": "Twitch integration for Laravel — stream discovery, user info, channel management, and game search.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "twitch", "streaming", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-twitch": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Twitch\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Twitch\\TwitchServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
