{
    "name": "opencompanyapp/integration-twitter",
    "description": "Twitter/X integration for Laravel — manage tweets, search, and user profiles via the Twitter API v2.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "twitter", "x", "social", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-twitter": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Twitter\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Twitter\\TwitterServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
