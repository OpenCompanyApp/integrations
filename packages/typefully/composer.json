{
    "name": "opencompanyapp/integration-typefully",
    "description": "Typefully integration for Laravel — create drafts, list scheduled and published drafts, manage your Typefully account.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "typefully", "twitter", "newsletter", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-typefully": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Typefully\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Typefully\\TypefullyServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
