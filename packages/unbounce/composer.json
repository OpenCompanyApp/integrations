{
    "name": "opencompanyapp/integration-unbounce",
    "description": "Unbounce integration for Laravel — list pages, manage leads, sub accounts, and more.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "unbounce", "marketing", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-unbounce": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Unbounce\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Unbounce\\UnbounceServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
