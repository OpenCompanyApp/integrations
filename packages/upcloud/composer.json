{
    "name": "opencompanyapp/integration-upcloud",
    "description": "UpCloud integration for Laravel — manage cloud servers, storages, networks, and IPs.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "upcloud", "cloud", "hosting", "servers", "productivity", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-upcloud": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Upcloud\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Upcloud\\UpcloudServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
