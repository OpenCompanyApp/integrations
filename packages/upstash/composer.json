{
    "name": "opencompanyapp/integration-upstash",
    "description": "Upstash Redis integration for Laravel — manage keys, databases, and teams via the Upstash REST and Platform APIs.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "upstash", "redis", "serverless", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-upstash": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Upstash\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Upstash\\UpstashServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
