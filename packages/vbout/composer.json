{
    "name": "opencompanyapp/integration-vbout",
    "description": "VBout integration for Laravel — manage contacts and email campaigns.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "vbout", "marketing", "email", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-vbout": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Vbout\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Vbout\\VboutServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
