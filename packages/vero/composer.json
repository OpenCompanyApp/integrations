{
    "name": "opencompanyapp/integration-vero",
    "description": "Vero integration for Laravel — identify users, track events, update user profiles, and manage tags.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "vero", "email", "crm", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-vero": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Vero\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Vero\\VeroServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
