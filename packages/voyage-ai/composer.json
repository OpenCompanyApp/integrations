{
    "name": "opencompanyapp/integration-voyage-ai",
    "description": "Voyage AI integration for Laravel — embeddings, reranking, multimodal embeddings, files, and batch inference.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "voyage", "voyage-ai", "embeddings", "rerank", "rag", "opencompany"],
