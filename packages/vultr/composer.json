{
    "name": "opencompanyapp/integration-vultr",
    "description": "Vultr integration for Laravel — manage instances, plans, regions, snapshots, and SSH keys.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "vultr", "cloud", "instances", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-vultr": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Vultr\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Vultr\\VultrServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
