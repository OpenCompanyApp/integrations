{
    "name": "opencompanyapp/integration-wealthbox",
    "description": "Wealthbox CRM integration for Laravel — manage contacts, tasks, opportunities, workflows, and events.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "wealthbox", "crm", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-wealthbox": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Wealthbox\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Wealthbox\\WealthboxServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
