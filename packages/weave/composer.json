{
    "name": "opencompanyapp/integration-weave",
    "description": "Weave healthcare integration for Laravel — manage patients, appointments, and messages.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "weave", "healthcare", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-weave": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Weave\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Weave\\WeaveServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
