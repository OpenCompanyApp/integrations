{
    "name": "opencompanyapp/integration-weaviate",
    "description": "Weaviate vector database integration for Laravel — manage schemas, search and CRUD objects.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "weaviate", "vector-database", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-weaviate": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Weaviate\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Weaviate\\WeaviateServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
