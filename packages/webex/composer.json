{
    "name": "opencompanyapp/integration-webex",
    "description": "Cisco Webex integration for Laravel: rooms, messages, people, teams, meetings, and webhooks.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "webex", "cisco", "communication", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-webex": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Webex\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Webex\\WebexServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
