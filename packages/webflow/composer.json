{
    "name": "opencompanyapp/integration-webflow",
    "description": "Webflow CMS integration for Laravel — manage sites, collections, and items.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "webflow", "cms", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-webflow": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Webflow\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Webflow\\WebflowServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
