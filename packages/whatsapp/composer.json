{
    "name": "opencompanyapp/integration-whatsapp",
    "description": "WhatsApp Business Platform integration for Laravel: messages, media, templates, phone numbers, profiles, and webhooks.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "whatsapp", "communication", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-whatsapp": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\WhatsApp\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\WhatsApp\\WhatsAppServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
