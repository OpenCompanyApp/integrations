{
    "name": "opencompanyapp/integration-whereby",
    "description": "Whereby video meetings integration for Laravel — manage rooms, meetings, and user profiles.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "whereby", "video", "meetings", "communication", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-whereby": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Whereby\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Whereby\\WherebyServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
