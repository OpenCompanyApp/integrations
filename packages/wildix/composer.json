{
    "name": "opencompanyapp/integration-wildix",
    "description": "Wildix PBX integration for Laravel — list calls, extensions, and users.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "wildix", "communication", "pbx", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-wildix": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Wildix\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Wildix\\WildixServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
