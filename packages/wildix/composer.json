{
    "name": "opencompanyapp/integration-wildix",
    "description": "Wildix WMS/PBX integration for Laravel agents using the official API client operation surface.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": [
        "tools",
        "wildix",
        "pbx",
        "wms",
        "opencompany"
    ],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0"
    },
    "replace": {
        "opencompanyapp/ai-tool-wildix": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Wildix\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Wildix\\WildixServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
