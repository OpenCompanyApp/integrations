{
    "name": "opencompanyapp/integration-wordpress",
    "description": "WordPress REST API integration for Laravel — manage posts, pages, users, and comments.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "wordpress", "cms", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-wordpress": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\WordPress\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\WordPress\\WordPressServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
