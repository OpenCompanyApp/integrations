{
    "name": "opencompanyapp/integration-workable",
    "description": "Workable ATS integration for Laravel — manage jobs, candidates, and team members.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "workable", "ats", "recruiting", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-workable": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Workable\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Workable\\WorkableServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
