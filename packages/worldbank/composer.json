{
    "name": "opencompanyapp/integration-worldbank",
    "description": "World Bank Indicators API v2 integration for Laravel: countries, aggregates, sources, topics, indicators, languages, and development data.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "worldbank", "economics", "gdp", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-worldbank": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\WorldBank\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\WorldBank\\WorldBankServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
