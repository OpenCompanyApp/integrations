{
    "name": "opencompanyapp/integration-wp-engine",
    "description": "WP Engine integration for Laravel — manage WordPress hosting sites and installs.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "wp-engine", "wordpress", "hosting", "productivity", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-wp-engine": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\WpEngine\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\WpEngine\\WpEngineServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
