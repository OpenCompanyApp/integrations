{
    "name": "opencompanyapp/integration-wufoo",
    "description": "Wufoo API v3 integration for Laravel — forms, entries, fields, reports, users, comments, and webhooks.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "wufoo", "forms", "entries", "reports", "webhooks", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-wufoo": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Wufoo\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Wufoo\\WufooServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
