{
    "name": "opencompanyapp/integration-xero",
    "description": "Xero integration for OpenCompany – invoices, contacts, and accounts.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "opencompanyapp/integration-core": "*"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Xero\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Xero\\XeroServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
