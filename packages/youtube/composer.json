{
    "name": "opencompanyapp/integration-youtube",
    "description": "YouTube Data API v3 integration for Laravel AI agents - generated coverage for videos, channels, playlists, comments, captions, live chat, live broadcasts, subscriptions, search, and media uploads.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "opencompanyapp/integration-core": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\YouTube\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\YouTube\\YouTubeServiceProvider"
            ]
        }
    },
    "keywords": [
        "tools",
        "youtube",
        "google",
        "video",
        "media",
        "opencompany"
    ]
}
