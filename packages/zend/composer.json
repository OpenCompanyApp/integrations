{
    "name": "opencompanyapp/integration-zend",
    "description": "Zendesk email marketing automation integration for Laravel — manage campaigns, lists, and subscribers.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "zend", "zendesk", "email", "marketing", "automation", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-zend": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Zend\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Zend\\ZendServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
