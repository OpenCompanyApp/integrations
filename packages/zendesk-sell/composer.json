{
    "name": "opencompanyapp/integration-zendesk-sell",
    "description": "Zendesk Sell integration for Laravel with CRM records, activities, products, pipelines, users, and reference data.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "zendesk-sell", "zendesk", "sell", "crm", "sales", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-zendesk-sell": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\ZendeskSell\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\ZendeskSell\\ZendeskSellServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
