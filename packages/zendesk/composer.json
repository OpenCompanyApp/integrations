{
    "name": "opencompanyapp/integration-zendesk",
    "description": "Zendesk integration for OpenCompany – tickets, users, and organizations.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "opencompanyapp/integration-core": "*"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Zendesk\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Zendesk\\ZendeskServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
