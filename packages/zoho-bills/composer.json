{
    "name": "opencompanyapp/integration-zoho-bills",
    "description": "Zoho Bills integration for Laravel — manage invoices, customers, items, and billing.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "zoho", "bills", "invoices", "payments", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-zoho-bills": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\ZohoBills\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\ZohoBills\\ZohoBillsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
