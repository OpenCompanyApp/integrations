{
    "name": "opencompanyapp/integration-zoho-desk",
    "description": "Zoho Desk integration for Laravel — manage tickets, contacts, articles, and departments.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "zoho", "zoho-desk", "support", "helpdesk", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-zoho-desk": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\ZohoDesk\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\ZohoDesk\\ZohoDeskServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
