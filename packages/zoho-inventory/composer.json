{
    "name": "opencompanyapp/integration-zoho-inventory",
    "description": "Zoho Inventory integration for Laravel — manage items, sales orders, shipments, and packages.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "zoho", "inventory", "ecommerce", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-zoho-inventory": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\ZohoInventory\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\ZohoInventory\\ZohoInventoryServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
