{
    "name": "opencompanyapp/integration-zoho-sheet",
    "description": "Zoho Sheet integration for Laravel — manage spreadsheets, worksheets, and rows.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "zoho", "sheet", "spreadsheets", "productivity", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-zoho-sheet": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\ZohoSheet\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\ZohoSheet\\ZohoSheetServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
