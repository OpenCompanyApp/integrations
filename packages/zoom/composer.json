{
    "name": "opencompanyapp/integration-zoom",
    "description": "Zoom integration for Laravel — list meetings, get user profiles, manage recordings, and handle video conferencing.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "zoom", "communication", "video", "meetings", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-zoom": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Zoom\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Zoom\\ZoomServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
