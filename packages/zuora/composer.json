{
    "name": "opencompanyapp/integration-zuora",
    "description": "Zuora subscription management integration for Laravel — query accounts, subscriptions, invoices, and payments.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "zuora", "billing", "subscriptions", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-zuora": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Zuora\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Zuora\\ZuoraServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
