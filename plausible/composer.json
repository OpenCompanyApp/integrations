{
    "name": "opencompanyapp/integration-plausible",
    "description": "Plausible Analytics integration for Laravel — query stats, realtime visitors, manage sites and goals.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "plausible", "analytics", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-plausible": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\Plausible\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\Plausible\\PlausibleServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
