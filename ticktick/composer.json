{
    "name": "opencompanyapp/integration-ticktick",
    "description": "TickTick integration for Laravel — manage projects and tasks.",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["tools", "ticktick", "tasks", "productivity", "opencompany"],
    "require": {
        "php": "^8.2",
        "opencompanyapp/integration-core": "^2.0 || @dev"
    },
    "replace": {
        "opencompanyapp/ai-tool-ticktick": "self.version"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\Integrations\\TickTick\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenCompany\\Integrations\\TickTick\\TickTickServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
